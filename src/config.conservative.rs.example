pub const GBOOST_MIN_HOURLY_BID_SUM: Decimal = dec!(0.70);
pub const GBOOST_MIN_SECS_TO_EXPIRY: i64 = 900;
pub const GBOOST_MAX_SNAPSHOT_AGE_SECS: i64 = 10;

/// Minimum hourly YES bid / maximum hourly YES ask allowed at GBoost entry.
/// Guards against entering a daily position when the hourly market is near-resolved.
pub const GBOOST_MIN_HOURLY_YES_BID: Decimal = dec!(0.35);
pub const GBOOST_MAX_HOURLY_YES_ASK: Decimal = dec!(0.95);

/// Block DAILY NO entries when the current hourly market shows BTC strongly
/// trending UP (hourly YES bid above this threshold), and DAILY YES entries when
/// the hourly YES bid drops below (1 − this). Strong hourly trend predicts the
/// daily follows, making the opposite-side daily entry systematically unprofitable.
pub const GBOOST_HOURLY_STRONG_TREND_BLOCK: Decimal = dec!(0.65);

/// Seconds BTC spot must stay below (daily_strike − BASIS_BTC_ORACLE_STRIKE_BUFFER)
/// before GBoost YES entries are suppressed. 3600s = 60 min sustained below-strike.
pub const GBOOST_BELOW_STRIKE_SUPPRESS_SECS: i64 = 3600;

// ── GBoost dynamic position sizing ───────────────────────────────────────────

/// Conservative: very small floor — minimal capital on borderline signals.
pub const GBOOST_MIN_EXPOSURE_USDC: Decimal = dec!(1.0);

/// Conservative: lower vol threshold — reduce size earlier as oracle gets noisy.
pub const GBOOST_HIGH_VOL_REGIME_THRESHOLD: f64 = 0.55;

/// Conservative: more aggressive size reduction in elevated vol (40% of base).
pub const GBOOST_HIGH_VOL_SIZE_SCALE: f64 = 0.40;

/// Conservative: 30-minute SL cooldown — longest wait after an adverse stop.
pub const GBOOST_SL_POST_EXIT_COOLDOWN_SECS: i64 = 1800;

/// Minimum expected net profit (USDC) after round-trip fees required to place a GBoost entry.
/// Conservative: $0.20 — higher bar; only high-conviction signals with meaningful net edge.
pub const GBOOST_MIN_NET_PROFIT_USDC: Decimal = dec!(0.20);

/// Market-level entry hold lock (seconds) before GBoost may flip direction on a market.
/// Conservative: 300s — five minutes; requires strong new signal before reversing direction.
pub const GBOOST_MIN_HOLDING_LOCK_SECS: i64 = 300;

///  When the live data distribution deviates
/// significantly from the training distribution (as measured by perpetual's leaf-node
/// chi-squared statistic), GBoost entries are suppressed until the next retrain.
/// Conservative: 20.0 — recalibrated to the live-session drift-score scale (see
/// the standard config's 22.0 baseline note: normal BTC intraday vol scores
/// 15–21; genuine regime collapse scores 22+). Conservative suppresses slightly
/// earlier than balanced to protect capital.
/// NOTE: this scale is only valid with GBOOST_DRIFT_WINDOW = 400.
pub const GBOOST_CONCEPT_DRIFT_THRESHOLD: Decimal = dec!(20.0);

/// Number of recent history snapshots used for the post-retrain drift check.
/// 400 ticks (~3-4 min at the 500ms decimated cadence) — the drift-score scale
/// the thresholds above are calibrated against; do not shrink independently.
pub const GBOOST_DRIFT_WINDOW: usize = 400;

/// Number of consecutive retrains above GBOOST_CONCEPT_DRIFT_THRESHOLD required
/// before GBoost entries are suppressed.  A single retrain below the threshold
/// resets the counter and clears suppression.
/// Conservative: 3 — one transient spike (order-flow shock, rapid BTC move) is
/// tolerated; three consecutive 20+ scores means the regime has genuinely shifted.
pub const GBOOST_DRIFT_CONSECUTIVE_REQUIRED: usize = 3;

/// Number of consecutive BELOW-threshold retrains to clear drift suppression.
/// Conservative: 3 — requires extended stability before re-enabling entries after drift.
pub const GBOOST_DRIFT_STABLE_CLEAR_REQUIRED: usize = 3;

