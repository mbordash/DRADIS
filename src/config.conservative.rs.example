pub const TRADE_COOLDOWN_SECS: i64 = 15;
pub const PARTIAL_FILL_COOLDOWN_SECS: i64 = 60;
pub const STOP_LOSS_COOLDOWN_SECS: u64 = 180;
/// Cooldown period (in seconds) before retrying a failed exit order.
/// This prevents log floods and API hammering when FAK exits fail due to thin books.
pub const EXIT_RETRY_COOLDOWN_SECS: u64 = 5;

/// Kalshi categories that back DRADIS's `politics` market class.
///
/// Kalshi splits what DRADIS calls politics across two of its own categories,
/// and the larger one is "Elections" — omitting it hides roughly 4,000 open
/// markets. Verified against the live API 2026-08-22: Elections 3,982 open
/// markets, Politics 644, Sports 815.
pub const KALSHI_POLITICS_CATEGORIES: &str = "Elections,Politics";

/// Kalshi categories that back DRADIS's `sports` market class.
pub const KALSHI_SPORTS_CATEGORIES: &str = "Sports";

/// How far the exit price implied by collateral movement may sit from the bid
/// observed at exit, before the reconciliation is distrusted.
///
/// When the exchange rejects a sell with "position already gone", the P&L is
/// taken from the collateral delta across the round trip and the exit price is
/// derived from it. Two things can make that number wrong: another position
/// moving collateral in between, or a baseline captured on the wrong side of the
/// entry. Both throw the derived price away from the bid, so this band catches
/// them and the trade is booked as `ExitUnreconciled` with pnl = 0 instead.
///
/// Measured against the BID, not the entry price. Measuring from entry was a
/// real bug (production trade 378, 2026-08-20): FairValue took a legitimate
/// 20.27 percent profit, which sat 0.15 from its entry and was discarded as an
/// outlier while the bid it actually traded against was 0.026 away.
///
/// Wider = more exits priced automatically, with more risk of trusting a
/// contaminated baseline. Narrower = more booked as 0 and left for manual
/// reconciliation. Estimating from the order book is not an option at any
/// setting: that path is only reached on a rejected sell, where the book is
/// evidence of nothing.
pub const EXIT_RECONCILE_MAX_DEVIATION: Decimal = dec!(0.06);

/// Balance re-check attempts when a maker quote-pull finds the resting order GONE but the
/// on-chain balance reads zero (fully-filled order + settlement lag). Conservative: 5
/// attempts (~20s window) — maximum patience before declaring a position gone.
pub const SETTLEMENT_LAG_RETRY_ATTEMPTS: u32 = 5;

/// Seconds between successive balance re-checks in the quote-pull settlement-lag loop.
pub const SETTLEMENT_LAG_RETRY_DELAY_SECS: u64 = 5;

/// Exit FAK "not enough balance" rejections within this many seconds of fill confirmation
/// are always treated as settlement lag (hold + retry), never booked as est. exits.
/// Conservative: 120s — widest grace; never writes off a fresh fill on a lagging read.
pub const FRESH_FILL_SETTLEMENT_GRACE_SECS: i64 = 120;

/// Cooldown after a post-only maker quote is rejected for crossing the book.
/// Prevents tick-rate re-quote hammering while the book stays crossed.
/// Conservative: longer cooldown — wait for the book to settle decisively.
pub const MAKER_CROSSES_BOOK_COOLDOWN_SECS: u64 = 30;

/// Flash-Exit: operational constants — same across all profiles.
pub const FLASH_EXIT_CONFIRM_MS: u64 = 12_000;
pub const FLASH_EXIT_POLL_MS: u64 = 500;
pub const FLASH_EXIT_EXTRA_OFFSET: Decimal = dec!(0.02);

pub const MIN_SECONDS_TO_EXPIRY_FOR_ENTRY: i64 = 600;
pub const MAX_SECONDS_TO_EXPIRY_FOR_ENTRY: i64 = 14400;
pub const FINAL_EXPIRY_WINDOW_SECS: i64 = 900;
pub const MARKET_EXPIRY_SAFETY_BUFFER_SECS: i64 = 300;


