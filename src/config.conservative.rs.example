pub const TIME_DECAY_MAX_ENTRY_PRICE: Decimal = dec!(0.46);
pub const TIME_DECAY_MIN_ENTRY_PRICE: Decimal = dec!(0.38);

/// OBI gate: block entry when the order book is heavily one-sided.
