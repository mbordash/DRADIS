pub const MAKER_ORACLE_DRIFT_PULL_FRAC: Decimal = dec!(0.0002); // 08-04: tightened from 0.0003 in line with prod cancel-race evidence.
/// Gate-dwell: gates must pass continuously this long before quoting.
/// Conservative: 30s — only quote into persistently calm books.
pub const MAKER_GATE_DWELL_SECS: i64 = 30;

// ── Horizon Raptor maker gate (2026-07-21, observe-first) ───────────────────
/// Master switch: false = observe-only (log "would veto", never suppress).
/// Conservative: enforced — never quote into a flagged macro regime.
pub const MAKER_HORIZON_GATE_ENFORCE: bool = true;
/// Suppress BOTH maker sides when UVXY 5s velocity exceeds this ($/5s).
pub const MAKER_HORIZON_VIX_VEL_MAX: Decimal = dec!(0.07);
/// Suppress the adverse maker side when |tradfi_velocity| exceeds this ($/5s).
pub const MAKER_HORIZON_TRADFI_VETO: Decimal = dec!(0.10);
/// Directional TradFi vetoes require at least this QQQ-vs-BTC macro coherence.
pub const MAKER_HORIZON_COHERENCE_MIN: Decimal = dec!(0.4);
pub const MAKER_BID_BUFFER: Decimal = dec!(0.04);
/// Requires a wider spread before posting — more edge per fill.
pub const MAKER_MIN_SPREAD: Decimal = dec!(0.05);
pub const MAKER_BID_IMPROVEMENT: Decimal = dec!(0.01);
pub const MAKER_BID_IMPROVEMENT_RATIO: Decimal = dec!(0.25);
pub const MAKER_MIN_BID_IMPROVEMENT: Decimal = dec!(0.01);
pub const MAKER_MAX_BID_IMPROVEMENT: Decimal = dec!(0.02);
pub const MAKER_CROSS_BUFFER: Decimal = dec!(0.02);
pub const CROSSES_BOOK_COOLDOWN_SECS: i64 = 60;
/// Conservative: longer pause before retrying a rejected entry — lets the book
/// settle before re-attempting to avoid repeated rejections.
pub const CROSSES_BOOK_RETRY_PAUSE_SECS: u64 = 8;

/// Won't post maker orders within 45 minutes of expiry.
pub const MAKER_MIN_SECS_TO_EXPIRY: i64 = 2700;
/// Conservative horizon — only looks at markets closing within 12 hours.
pub const MAKER_MAX_SECS_TO_EXPIRY: i64 = 43200;

/// Lower max entry price — only post bids on genuinely uncertain markets.
pub const MAKER_MAX_ENTRY_PRICE: Decimal = dec!(0.48);
pub const MAKER_MAX_COMPLEMENTARY_PRICE: Decimal = dec!(0.58);
pub const MAKER_MIN_ENTRY_PRICE: Decimal = dec!(0.10);

pub const MAKER_TARGET_PROFIT_PERCENT: Decimal = dec!(0.10);
pub const MAKER_STOP_LOSS_PERCENT: Decimal = dec!(0.10);
pub const MAKER_LATE_MARKET_STOP_TIGHTEN_SECS: i64 = 3600;
pub const MAKER_LATE_MARKET_STOP_LOSS_PERCENT: Decimal = dec!(0.05);

/// Longer hold before stop-loss can fire — avoids cutting on noise.
pub const MAKER_MIN_HOLD_SECS_BEFORE_STOP: i64 = 900;
pub const MIN_HOLD_SECS_BEFORE_STOP_LOSS: i64 = MAKER_MIN_HOLD_SECS_BEFORE_STOP;
/// Catastrophic floor at (live SL × mult), ungated by min-hold (2026-07-14).
/// Conservative: tightest hard floor — cut fast moves early.
pub const MAKER_CATASTROPHIC_SL_MULT: Decimal = dec!(1.25);
pub const MAKER_STOP_LOSS_COOLDOWN_SECS: i64 = 900;
pub const MAKER_MAX_COMBINED_BID: Decimal = dec!(0.82);
pub const MAKER_MAX_BOOK_IMBALANCE_RATIO: Decimal = dec!(2.5);

/// Taker-flow / bid-depth drain gate.
/// Conservative: trigger suppression at just 30% bid-depth drain — exits early and
/// blocks aggressively to minimize adverse fills on thin illiquid books.
pub const MAKER_TAKER_FLOW_WINDOW_MS: u64 = 1500;
/// Minimum elapsed ms between depth snapshots before the drain check runs.
/// Prevents price-level rotation (normal tick moves) from false-triggering suppression.
pub const MAKER_TAKER_FLOW_MIN_ELAPSED_MS: u64 = 500;
pub const MAKER_TAKER_FLOW_DRAIN_THRESHOLD: Decimal = dec!(0.30);
/// Conservative: force-exit open positions at OBI < -0.35 — cuts losses before
/// the book has fully turned, accepting a smaller realized loss over a larger one.
pub const MAKER_TOXIC_FLOW_EXIT_OBI: Decimal = dec!(-0.35);
/// After a ToxicFill exit, block re-entry on that same token for this long.
/// Prevents the maker from immediately re-quoting into a collapsing book and
/// getting picked off again (the "double knife-catch" adverse-selection loss).
/// Conservative: longer 5-minute re-entry lockout.
pub const MAKER_TOXIC_REENTRY_COOLDOWN_SECS: i64 = 300;

// ── Operator-deployed squadron horizon (2026-08-23) ─────────────────────────
//
// Longest time-to-resolution a Quick deploy will auto-select, in days.
//
// Market DISCOVERY deliberately looks much further out — Kalshi structures
// politics and sports as multi-year futures, and a browse list that hides them
// shows an empty category. Auto-SELECTION is a different question: the vipers
// available to those classes are Arbitrage and Maker, and neither works on a
// multi-year horizon. Arbitrage locks collateral until resolution, so a two-year
// market ties up the whole book for a few percent; Maker rests quotes expecting
// fills and reversion on a session scale. A market resolving in 2028 is a
// perfectly good market and a bad thing to point these strategies at.
//
// Raising this widens what Quick deploy may choose; it does not change what the
// browse list shows, so an operator can always deploy a longer-dated market
// deliberately by picking it by hand.
pub const DEPLOY_MAX_DAYS_TO_CLOSE: u32 = 30;

// ── Order-book imbalance source (2026-08-23) ────────────────────────────────
//
// Whether the OBI entry gates read whole-book depth instead of the touch.
//
// The touch is the size resting at the best price only. On a thin book that is
// one or two contracts, so a ratio built from it swings wildly on trades that
// move nothing. Measured over 1,720 leg-samples on Kalshi, the two disagreed in
// SIGN 41% of the time, and 188 of 247 crypto entry vetoes fired on a touch the
// rest of the book contradicted — the extreme case reading +0.97 at the touch
// against -0.01 across a book holding 683,574 vs 702,306 contracts.
//
// Defaults to false — the touch — because that measurement is from Kalshi and
// the gate is venue-neutral. Switching cut simulated crypto vetoes by 57%, which
// is a large loosening of a risk control to apply to a venue on the strength of
// another venue's book structure. Turn it on per squadron, compare, then decide.
//
// Deliberately does NOT affect the GBoost feature vector: that model is trained
// on touch-derived features, and changing their meaning underneath it at runtime
// would leave it predicting from a distribution it never saw.
pub const OBI_USE_WHOLE_BOOK: bool = false;

// ── ToxicFill confirmation gates ────────────────────────────────────────────
// Applied ONLY to a confirmed fill; an unfilled resting quote is still pulled
// instantly. Without them the exit fires on the OBI dip caused by our own quote
// being lifted, paying the spread to realize a loss price has not inflicted.

/// Minimum seconds held before ToxicFill may fire.
/// Conservative: shortest window — bail out of a hostile book soonest.
pub const MAKER_TOXIC_MIN_HOLD_SECS: i64 = 20;

/// Bid must be at least this fraction below avg entry for ToxicFill to fire.
/// Conservative: 1.5% — reacts to the smallest genuine adverse move.
pub const MAKER_TOXIC_MIN_ADVERSE_PCT: Decimal = dec!(0.015);

/// Consecutive OBI breaches required before ToxicFill fires.
/// Conservative: 2 ticks — minimum flicker filtering, quickest to act.
pub const MAKER_TOXIC_OBI_CONFIRM_TICKS: u32 = 2;

// ── Resting maker exit ──────────────────────────────────────────────────────
// Post a post-only GTC ASK against a filled position so it exits by being
// lifted (spread capture) rather than crossing back to the bid. FAK-at-bid
// still handles stops, ToxicFill and the near-expiry flatten.

/// Master switch for the resting-ask maker exit.
pub const MAKER_RESTING_EXIT_ENABLED: bool = true;

/// Price floor for the resting ask, as a fraction over avg entry.
/// Conservative: 5% — insists on a clear edge before committing shares to a rest.
pub const MAKER_RESTING_EXIT_MIN_EDGE_PCT: Decimal = dec!(0.05);

/// Ticks to undercut the best ask by when posting the resting exit.
/// Conservative: 1 — buy queue priority so positions actually convert.
pub const MAKER_RESTING_EXIT_ASK_IMPROVEMENT_TICKS: i64 = 1;

/// Minimum price change before an existing resting ask is repriced.
/// Conservative: 2¢ — wide deadband, surrenders queue priority least often.
pub const MAKER_RESTING_EXIT_REPRICE_THRESHOLD: Decimal = dec!(0.02);

/// Slow trend threshold as fraction of oracle price.
/// 0.004 = 0.40% of price. Conservative: wider threshold before suppressing bids.
pub const MAKER_SLOW_TREND_THRESHOLD_PCT: Decimal = dec!(0.004);
/// When inventory is fully imbalanced, adjust bids by up to this amount.
/// Conservative: 2¢ max skew — gentler rebalancing.
pub const MAKER_INVENTORY_SKEW_MAX: Decimal = dec!(0.02);

/// Waits 10 minutes after market open before posting any maker orders.
pub const MAKER_MIN_MARKET_AGE_SECS: i64 = 600;
/// Throttle interval (secs) for MakerStrategy gate-rejection diagnostics — a gate
/// reason is logged when it changes or after this interval, without per-tick spam.
pub const MAKER_GATE_LOG_INTERVAL_SECS: u64 = 30;

/// Re-log interval for a TimeDecay gate rejection whose reason has NOT changed.
/// A change of reason always logs immediately; this only paces the repeat.
///
/// 300s (vs the maker's 30s) because TimeDecay evaluates a much slower condition:
/// its theta window is minutes wide and its blocking gate can legitimately hold
/// for a whole market. Gives a recoverable on-disk history of which gate blocks
/// it, which the in-memory viper_status registry alone cannot provide.
pub const TIME_DECAY_GATE_LOG_INTERVAL_SECS: u64 = 300;
pub const MOMENTUM_MIN_MARKET_AGE_SECS: i64 = 600;
/// Must be strictly > MOMENTUM_EXPIRY_EXIT_SECS (1200s); 5 min breathing room.
pub const MOMENTUM_MIN_SECS_TO_EXPIRY_FOR_ENTRY: i64 = 1500;

/// Minimum seconds since market switch before MomentumStrategy is allowed to enter.
/// Conservative: 90s — longer warmup for fully stable orderbook depth and OBI readings.
/// Root cause fix for 2026-05-27 20:11 loss (−$0.73): entry fired 6s after switch.
pub const MOMENTUM_MARKET_WARMUP_SECS: i64 = 90;


// ============================================================================
// BASIS / FUNDING RATE STRATEGY PARAMETERS
// ============================================================================

/// Basis disabled in conservative mode — requires more experience to calibrate.
pub const ENABLE_BASIS_TRADING: bool = false;

/// Higher skew required before considering a fade.
pub const BASIS_ENTRY_SKEW_THRESHOLD: Decimal = dec!(0.10);

pub const BASIS_NEGATIVE_FUNDING_THRESHOLD: Decimal = dec!(-0.0001);
pub const BASIS_POSITIVE_FUNDING_THRESHOLD: Decimal = dec!(0.0001);
