// ============================================================================
// TIDE RAPTOR — "Institutional Pulse" spot-BTC-ETF premium signal
// ============================================================================
// Observe-only macro Raptor (BTC-only). Computes a synthetic iNAV for each of
// the Big Three spot BTC ETFs (IBIT / FBTC / ARKB) from the live Binance oracle
// (btc_per_share x oracle), compares it to the real-time equity print, and
// aggregates the per-ETF premium/discount into a volume-weighted, vol-normalized
// "Institutional Pulse" plus a 0..1 "Coherence" agreement score.

/// How often the Tide Raptor recomputes the pulse from the latest oracle +
/// equity prints. Local compute only (no network), so cheap.
pub const TIDE_RECOMPUTE_SECS: u64 = 2;

/// Rolling window length (samples) for each ETF's premium z-score buffer.
pub const TIDE_ZSCORE_WINDOW: usize = 90;

/// Max age (seconds) of an ETF's last equity print before its weight drops to 0.
pub const TIDE_QUOTE_STALENESS_SECS: u64 = 30;

/// Rolling window (seconds) over which each ETF's traded dollar-volume is summed.
pub const TIDE_VOLUME_WINDOW_SECS: u64 = 60;

/// Env var names for the Alpaca free-tier real-time IEX equity feed. Absent =>
/// Raptor runs observe-only (synthetic iNAV only, zero pulse).
pub const TIDE_ALPACA_KEY_ENV:    &str = "ALPACA_API_KEY_ID";
pub const TIDE_ALPACA_SECRET_ENV: &str = "ALPACA_API_SECRET_KEY";
/// Minimum best-bid required to fire a basis stop-loss exit.
/// Prevents log floods and API hammering when FAK exits fail due to thin books.
pub const BASIS_MIN_STOP_LOSS_EXIT_BID: Decimal = dec!(0.005);

// ── Horizon Raptor (TradFi velocity / VIX proxy) ──────────────────────────────
//
// NOTE: The Horizon Raptor shares the Alpaca IEX connection with the Tide Raptor
// (via SharedQuoteMap). No separate Alpaca credentials needed.

/// Compute tick interval for the Horizon Raptor signal recompute loop.
pub const HORIZON_TICK_MS: u64 = 500;

/// Max age (seconds) of an equity quote before it's considered stale.
pub const HORIZON_QUOTE_STALENESS_SECS: u64 = 30;

/// Rolling window (seconds) for the macro coherence Pearson correlation
/// between BTC velocity and QQQ velocity. 10 minutes = 600s.
pub const HORIZON_CORRELATION_WINDOW_SECS: u64 = 600;


// ── Sports Raptor (The Odds API line-movement feed) ──────────────────────────
//
/// Env var carrying the The Odds API (the-odds-api.com) key. Absent ⇒ the Sports
/// Raptor runs idle/observe-only: it seeds a neutral snapshot, reports
/// `sports_connected = false`, and publishes no line-movement signal.
pub const SPORTS_ODDS_KEY_ENV: &str = "ODDS_API_KEY";

/// Sport key polled by the Sports Raptor. `upcoming` returns the next games
/// across all in-season sports — a broad, always-populated market-mood sample.
/// Override with a specific key (e.g. `americanfootball_nfl`) for a focused feed.
pub const SPORTS_ODDS_SPORT: &str = "upcoming";

/// Comma-separated bookmaker regions for the odds query (`us`, `uk`, `eu`, `au`).
pub const SPORTS_ODDS_REGIONS: &str = "us";

/// Seconds between Sports Raptor polls. The Odds API free tier is quota-limited
/// (~500 requests/month), so poll conservatively — line movement is a slow signal.
pub const SPORTS_POLL_SECS: u64 = 300;
pub const SPORTS_ODDS_LOW_BUDGET_WARN: i64 = 50;

// ── Tennis Raptor (Live Tennis API live event-state feed) ────────────────────
//
/// Env var carrying the Live Tennis API (livetennisapi.com) key. Absent ⇒ the
/// Tennis Raptor runs idle/observe-only: it seeds a neutral snapshot, reports
/// `tennis_connected = false`, and publishes no event-state signal.
pub const TENNIS_API_KEY_ENV: &str = "LIVETENNIS_API_KEY";

/// Optional tour filter for the live-match poll: `atp`, `wta`, `challenger`,
/// `itf` or `juniors`. Empty ⇒ all tours (the raptor then tracks the live match
/// with the freshest score). Narrow this to the tour whose markets you trade.
pub const TENNIS_TOUR: &str = "";

/// Seconds between Tennis Raptor polls. Honest budget note — the free tier
/// allows 30 req/min and 100 req/day: the 900s default fits ALL-DAY polling
/// inside the free cap (≤96 req/day); ~60s gives near point-level tracking but
/// burns the free day cap in ~100 minutes (fine for develop-and-test or a few
/// tracked matches; sustained all-day fast polling needs a paid tier). The top
/// tier's push WebSocket is NOT used by this raptor — v1 is REST-only, a WS
/// lane would arrive later as a separate config-gated option.
pub const TENNIS_POLL_SECS: u64 = 900;

/// Max age (seconds) of the tracked match's score timestamp before the feed is
/// reported stale (`tennis_connected = false`, so consumers widen/pull rather
/// than hold). Tennis pauses legitimately — changeovers ~90s, set breaks
/// ~120s+ — so this sits well above those to avoid flapping.
pub const TENNIS_SCORE_STALENESS_SECS: u64 = 600;

/// Warn when the API's X-RateLimit remaining-request count drops to this.
pub const TENNIS_LOW_BUDGET_WARN: i64 = 20;


// ============================================================================
// BASIS STRATEGY MAKER ORDER PARAMETERS
// ============================================================================

/// If true, BasisStrategy attempts to enter positions by placing limit orders
/// at the current bid price (or slightly adjusted) to act as a maker (0% fee).
/// If false, it places taker orders at the current ask price (incurs dynamic fee).
pub const BASIS_ENTRY_AS_MAKER: bool = true;

/// If BASIS_ENTRY_AS_MAKER is true, this offset is added to the current best bid
/// when placing a buy order.
/// - dec!(0.00): Bid at the current best bid (passive maker).
/// - dec!(0.01): Bid one tick above the current best bid (more aggressive maker,
///               but risks crossing the spread if the ask is also one tick away).
/// - dec!(-0.01): Bid one tick below the current best bid (more passive maker).
pub const BASIS_MAKER_BUY_PRICE_ADJUSTMENT: Decimal = dec!(-0.01);


