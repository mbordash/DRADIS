// ============================================================================
// CONSERVATIVE CONFIG EXAMPLE
// ============================================================================
//
// Designed for users who want to minimize risk and drawdown while learning
// the bot's behavior. Lower position sizes, tighter filters, fewer strategies.
//
// Good for: first-time users, small wallets (<$100), high-volatility markets.
//
// To use: copy this file to src/config.rs, then `cargo build --release`.
// ============================================================================

use rust_decimal::Decimal;
use rust_decimal_macros::dec;
use std::time::Duration as StdDuration;

// ============================================================================
// NOTIFICATION SETTINGS (Telegram)
// ============================================================================

pub const ENABLE_TELEGRAM: bool = false;
pub const ENABLE_X: bool = false;


// ============================================================================
// ARBITRAGE STRATEGY PARAMETERS
// ============================================================================

/// Dry-run mode — logs trades without executing them on-chain.
/// ⚠️ Set to `false` only after validating signals in ghost mode for 30+ minutes.
pub const GHOST_MODE: bool = false;

/// Should a BRAND-NEW install start in simulation?
///
/// Distinct from `GHOST_MODE`, and the distinction matters. `GHOST_MODE` is a
/// build-level switch compiled into the binary; setting it true would put a
/// running deployment into permanent simulation regardless of what its operator
/// chose. This one seeds only the DEFAULT of the runtime `ghost_mode` knob, so
/// it applies exactly once — to an install with no persisted config yet — and an
/// existing deployment keeps whatever is in its database.
///
/// True because the alternative is a customer's first experience of the product
/// being an unexpected real trade: the profile baked into the Marketplace AMI
/// enables five strategies, so saving credentials and restarting is enough to
/// start placing live orders. They can turn it off from the Control Tower the
/// moment they mean to.
pub const GHOST_MODE_DEFAULT: bool = true;
pub const ENABLE_ARBITRAGE_TRADING: bool = true;

/// Requires a wider margin before entering arbitrage — fewer trades, higher quality.
pub const ARBITRAGE_PROFIT_THRESHOLD: Decimal = dec!(0.025);
pub const ARBITRAGE_MAX_TAKER_FEE_BPS: u32 = 1500; // Updated from 100

/// Quote-persistence debounce: profitable bid_sum must hold continuously this many
/// seconds before the arb enters (filters phantom arbs during fast BTC moves).
pub const ARB_QUOTE_PERSISTENCE_SECS: u64 = 5;

/// Maximum allowable gap between our safe bid and the current ask on each arb leg.
/// Conservative profile: 3 ticks — only enter when the book is tight on both legs.
pub const ARBITRAGE_MAX_FILL_GAP: Decimal = dec!(0.03);

/// Maximum price allowed for either arb leg (YES bid OR NO bid).
/// Conservative: 0.55 — tighter band than balanced; requires near-symmetric books.
/// Root cause of the 2026-05-19 "10 YES / 40 NO" imbalance (YES=72¢, NO=27¢).
pub const ARBITRAGE_MAX_LEG_PRICE: Decimal = dec!(0.55);
pub const ARBITRAGE_MAX_LEG_OBI: Decimal = dec!(0.50);
pub const ARBITRAGE_MAX_OBI_ASYMMETRY: Decimal = dec!(0.60);
/// Min conviction: dominant leg bid must be ≥ this to enter — restricts arb to deep
/// near-settlement markets and rejects ≈0.50 coin-flips (core orphan guard).
/// Conservative: stricter 0.85 (fewer entries, lowest orphan risk).
pub const ARBITRAGE_MIN_LEG_CONVICTION: Decimal = dec!(0.95);
pub const ARB_FAK_REHEDGE_BUFFER: Decimal = dec!(0.02);

/// Seconds the orphan arbiter waits, after cancelling the missing leg's GTC,
/// before re-reading its on-chain balance and committing to a repair.
///
/// Guards one specific race: the cancel may have arrived just after a taker fill
/// that was still settling on-chain, and flattening on a stale zero balance
/// would sell a leg we actually own. The grace lets Polygon settle (~2s/block)
/// so Step 3's re-read sees the truth.
///
/// It is NOT the only protection, which is why it can be short: after the
/// flatten, ARBITER_LATE_FILL_WATCH_SECS keeps watching the missing leg and
/// flattens + books it if it fills late. The downside of guessing wrong is
/// therefore bounded at two spreads, while the cost of waiting is unbounded
/// naked directional exposure -- so shorter is the safer side of this trade.
///
/// Was hardcoded at 10s. On 2026-08-15 a TimeDecay leg took 26s from entry to
/// flatten (10s fill-confirm, 5s asymmetric grace, 10s here, ~1s to trade) while
/// YES collapsed 0.56 -> 0.38; the move was over before the repair began.
pub const ARB_SETTLE_GRACE_SECS: u64 = 2;
pub const ARB_FLATTEN_MIN_BID_BUFFER: Decimal = dec!(0.03);
pub const ARB_FLATTEN_BID_HAIRCUT_PCT: Decimal = dec!(0.06);

/// Upper bound on single-leg orphan rescue cost in the arb entry gate. Conservative:
/// tighter bound rejects lopsided books sooner — fewer fills, lower orphan risk.
pub const ARB_MAX_RESCUE_COST: Decimal = dec!(1.00);

pub const MAX_SUM_PRICE_FOR_ENTRY: Decimal = dec!(0.96);

/// Minimum shares and order size (exchange minimums — do not lower).
pub const MIN_ORDER_SHARES: Decimal = dec!(1.0);
pub const MIN_ORDER_USDC: Decimal = dec!(1.05);
/// Token-sovereignty dust threshold (notional USDC). A held position below this is
/// dust and won't block another viper from entering the same token. Conservative: 2.0
/// (stricter — respects existing claims more, fewer dust waivers).
pub const TOKEN_SOVEREIGNTY_DUST_NOTIONAL_USDC: Decimal = dec!(2.0);

/// Discount applied to current bid when setting avg_entry for a reconciled orphaned position.
/// Discount applied to current bid when setting avg_entry for a reconciled orphaned position.
/// Guarantees profit_margin ≈ 33% on first tick → immediate TakeProfit exit at current market price.
/// All profiles use the same value — reconciled positions should always exit promptly regardless of style.
pub const RECONCILE_ADOPTED_ENTRY_DISCOUNT: Decimal = dec!(0.25);

/// Requires 90% book depth before firing — very conservative on thin markets.
pub const MIN_LIQUIDITY_FILL_RATIO: Decimal = dec!(0.90);

pub const BUY_PRICE_OFFSET: Decimal = dec!(0.01);

// ── Fleet-wide risk controls (2026-06-29) ────────────────────────────────────
/// Conservative: flat sizing — never upsize into volatility.
pub const ENABLE_KELLY_SIZING: bool = false;
/// Block entries within this many seconds of resolution (gap-through risk).
pub const ENTRY_MIN_SECS_TO_RESOLUTION: i64 = 900;
/// Require exit-side bid depth ≥ position × this ratio (else stop gaps through).
pub const ENTRY_MIN_EXIT_BID_DEPTH_RATIO: Decimal = dec!(1.5);
pub const MOMENTUM_BUY_PRICE_OFFSET: Decimal = dec!(0.02);
pub const MOMENTUM_ENTRY_FAK_RETRIES: u32 = 1;
pub const MAX_BUY_LIMIT_PRICE: Decimal = dec!(0.95);
pub const SELL_PRICE_OFFSET: Decimal = dec!(0.01);
pub const MIN_SELL_LIMIT_PRICE: Decimal = dec!(0.01);

/// Polymarket taker fee rate: `fee = rate * p * (1 - p) * shares`, charged on
/// both legs of a round trip. Makers pay nothing. Venue fact, identical across
/// profiles — see src/config.rs for why it is 7% and not the advertised 1000 bps.
pub const INTL_TAKER_FEE_RATE: Decimal = dec!(0.07);
pub const EARLY_EXIT_COMBINED_BID_THRESHOLD: Decimal = dec!(0.995);


// ============================================================================
// MOMENTUM & ORACLE SETTINGS (Predictive Arbitrage)
// ============================================================================

/// Scale a percentage-based threshold to an absolute dollar amount using the
/// current oracle price.  Replaces the old per-asset dollar constants.
#[inline]
pub fn oracle_threshold(pct: Decimal, oracle_price: Decimal) -> Decimal {
    pct * oracle_price
}

/// Momentum is disabled in conservative mode — it's the riskiest strategy.
pub const ENABLE_MOMENTUM_TRADING: bool = false;

pub const MOMENTUM_KELLY_MAX_MULTIPLIER: Decimal = dec!(2.0);
pub const MOMENTUM_MIN_TRADE_SIZE_USDC: Decimal = dec!(3.0);
pub const MOMENTUM_MAX_TRADE_SIZE_USDC: Decimal = dec!(10.0);

/// Requires 3 consecutive confirming ticks to filter fakeouts aggressively.
pub const MOMENTUM_CONFIRMATION_TICKS: u32 = 3;

pub const MOMENTUM_TARGET_PROFIT_PERCENT: Decimal = dec!(0.06);
pub const MOMENTUM_STOP_LOSS_PERCENT: Decimal = dec!(0.10);

/// Requires a very strong reversal before exiting — avoids shaking out on noise.
pub const MOMENTUM_REVERSAL_RATIO: Decimal = dec!(1.00);
pub const MOMENTUM_MIN_HOLD_SECS_BEFORE_REVERSAL: i64 = 60;
pub const MOMENTUM_FILL_CONFIRM_MIN_HOLD_SECS: i64 = 45;
pub const MOMENTUM_MIN_HOLD_BEFORE_SL_SECS: i64 = 120;
pub const LATE_MARKET_SIZE_THRESHOLD_SECS: i64 = 2400;
pub const MOMENTUM_EXPIRY_EXIT_SECS: i64 = 1200;
pub const MOMENTUM_EXPIRY_MIN_PROFIT_TO_HOLD: Decimal = dec!(0.03);
pub const MOMENTUM_TAKE_PROFIT_CEILING: Decimal = dec!(0.90);

/// Multiple of the round-trip taker fee that the Momentum take-profit target must
/// clear. Venue fees are entry-price dependent — on Polymarket intl the round trip
/// costs 2 x rate x (1 - entry) of notional, so a $0.20 entry burns 11.2% while a
/// $0.80 entry burns only 2.8%. A flat percentage target is therefore below break-even
/// across part of the permitted entry range (at TP=6% every entry under $0.571 is a
/// guaranteed net loss). The effective target is raised to this multiple of the
/// computed fee whenever the configured target would not clear it.
/// Conservative: 1.50 — take-profit must beat fees by half again.
pub const MOMENTUM_TP_FEE_MARGIN_MULT: Decimal = dec!(1.50);

/// Tighter strike buffers — only trade when well away from the strike.
/// 0.001 = 0.10% of price. Conservative: 0.001 at BTC=$100k → $100.
pub const STRIKE_BUFFER_PCT: Decimal = dec!(0.001);

/// Lower max entry price — better risk/reward at conservative prices.
pub const MAX_MOMENTUM_ENTRY_PRICE: Decimal = dec!(0.50);
pub const MAX_MOMENTUM_CROSSING_ENTRY_PRICE: Decimal = dec!(0.52);
pub const MOMENTUM_MIN_ENTRY_PRICE: Decimal = dec!(0.20); // Conservative: 20-80% probability range only
pub const MOMENTUM_CATASTROPHIC_SL_PCT: Decimal = dec!(0.15); // Conservative: 1.5x the 10% stop-loss — a true last-resort floor

pub const MOMENTUM_WINDOW_SECS: u64 = 5;
pub const MOMENTUM_SHORT_WINDOW_SECS: u64 = 1;
pub const DRIFT_60M_MIN_WINDOW_SECS: u64 = 600;
pub const MOMENTUM_SHORT_WINDOW_FRACTION: Decimal = dec!(0.60);
pub const MOMENTUM_ACCELERATION_BYPASS_MULTIPLIER: Decimal = dec!(3.5);
pub const MOMENTUM_DECAY_EXIT_FRACTION: Decimal = dec!(0.30);

/// Higher threshold — only the strongest moves trigger entry.
/// 0.001 = 0.10% of oracle price/5s. Conservative: same PCT as default.
pub const MOMENTUM_THRESHOLD_PCT: Decimal = dec!(0.001);

/// Legacy alias kept for LLM advisor prompt references.
pub const BTC_MOMENTUM_THRESHOLD: Decimal = dec!(100.0);

/// Narrow window consensus filter — blocks entries unless longer-horizon market is near 50/50.
pub const MOMENTUM_WINDOW_BEARISH_BLOCK: Decimal = dec!(0.35);
pub const MOMENTUM_WINDOW_BULLISH_BLOCK: Decimal = dec!(0.65);

/// OBI adverse veto: block on even moderately adverse books — conservative style prioritizes
/// book quality over fill rate.
pub const MOMENTUM_OBI_ADVERSE_BLOCK: Decimal = dec!(-0.20);

/// OBI exhaustion veto: block entries when the bid side dominates entirely (all buyers, no sellers).
/// Conservative: 0.70 — tightest gate; mirrors GBOOST_OBI_EXHAUSTION_BLOCK conservative setting.
pub const MOMENTUM_OBI_EXHAUSTION_BLOCK: Decimal = dec!(0.70);

/// Deepest drawdown at which the in-position OBI-exhaustion exit may still fire.
/// Past this the position is already wrecked and the (catastrophic) stop-loss owns it,
/// so the early-reversal exit stands down. Conservative: -0.15 = 1.5x the 10% stop-loss.
pub const MOMENTUM_OBI_EXHAUST_MAX_ADVERSE_PCT: Decimal = dec!(-0.15);

/// Minimum seconds a Momentum position must be held before the in-position
/// OBI-exhaustion exit may fire. Without this the exit triggers on the first tick
/// after fill confirmation, when the position is underwater by the bid/ask spread
/// alone (2026-08-19 10:55 ET: entered $0.43, exited $0.40 five seconds later on a
/// -6.97% "loss" that was pure spread; the token went on to $0.95).
/// Mirrors MOMENTUM_MIN_HOLD_SECS_BEFORE_REVERSAL — OBI exhaustion is a reversal signal.
pub const MOMENTUM_OBI_EXHAUST_MIN_HOLD_SECS: i64 = 60;

/// How long the book must read exhausted, continuously, before the OBI exit fires.
/// Single-sample OBI on the hourly book is noise: the 2026-08-19 10:00-11:15 ET
/// heartbeats swing +0.95 -> -0.80 -> +0.93 -> -0.93 minute to minute, crossing the
/// 0.70 threshold constantly. Expressed in seconds rather than ticks deliberately —
/// the patrol loop runs at 75ms, so any tick count small enough to look reasonable
/// (3, 5, 10) is a quarter-second and filters nothing. Any non-exhausted reading
/// resets the clock. Conservative: 20s — slowest, most confirmation.
pub const MOMENTUM_OBI_EXHAUST_PERSIST_SECS: i64 = 20;

/// Maximum OBI swing allowed at Momentum entry.
/// Conservative: 0.65 — strictest gate; blocks any significant book-side oscillation.
pub const MOMENTUM_OBI_SWING_BLOCK: Decimal = dec!(0.65);

/// 10-minute oracle drift block as fraction of oracle price.
/// Conservative: 0.00025 = 0.025% — stricter; blocks contra-trend entries on smaller moves.
pub const MOMENTUM_DRIFT_10M_BLOCK_PCT: Decimal = dec!(0.00025);

/// Maximum combined ask sum (YES_ask + NO_ask) allowed for a Momentum entry.
/// Conservative: tight 2-cent spread cap — only enter on near-perfect books.
pub const MOMENTUM_MAX_ENTRY_ASK_SUM: Decimal = dec!(1.020);

/// Maximum age (seconds) of the live orderbook snapshot at Momentum entry.
/// Stale snapshots silently retain last-known OBI/depth values — unreliable veto data.
pub const MOMENTUM_MAX_SNAPSHOT_AGE_SECS: i64 = 15;


