/// Max `gboost_vetoes` rows labelled with their settled outcome per cleanup sweep.
///
/// The veto shadow-log records every entry-eligible signal a gate rejected; the
/// cleanup task attaches each one's real market resolution so the gate stack can
/// be scored on outcomes instead of on the model's own probability. Bounded per
/// sweep because each distinct market costs one Gamma request and the whole
/// cleanup pass runs under a 45s timeout — a large backlog drains over several
/// sweeps rather than starving orphan reconciliation, the safety-critical work
/// in that task.
pub const GBOOST_VETO_SCORING_BATCH: i64 = 200;
pub const GBOOST_POST_EXIT_COOLDOWN_SECS: i64 = 300;
/// Conservative: tightest OBI gate (2026-08-05: modest loosening from -0.25 with debounce protection).
pub const GBOOST_OBI_ADVERSE_BLOCK: Decimal = dec!(-0.40);
/// Entry-signal persistence debounce (2026-08-05): same side must stay eligible this long.
/// Conservative: longest hold — demands sustained conviction.
pub const GBOOST_ENTRY_PERSISTENCE_SECS: u64 = 180;
pub const GBOOST_SIGNAL_CONTINUITY_GAP_SECS: u64 = 30;
/// OBI EMA smoothing (2026-07-14). Conservative: longer tau demands sustained book support.
pub const GBOOST_OBI_EMA_TAU_SECS: f64 = 90.0;
pub const GBOOST_OBI_EMA_STALE_SECS: f64 = 30.0;
/// Minimum fraction of price distance from 0.50 required for a GBoost entry.
/// Conservative: higher edge requirement — only trade when there is meaningful directional conviction.
pub const GBOOST_MIN_EDGE_FROM_FAIR: Decimal = dec!(0.06);
/// Minimum net gain fraction required before a signal-reversal exit is allowed.
/// Conservative: higher bar — only allow reversal exit when there is solid realized profit.
pub const GBOOST_SIGNAL_REV_MIN_PROFIT: f64 = 0.06;
/// Maximum combined ask sum on the TARGET (daily/window) market at entry.
/// Conservative: strict 1.03 — only enter the daily book when it is very tight.
pub const GBOOST_MAX_TARGET_ASK_SUM: Decimal = dec!(1.03);
/// Hourly OBI adverse block for daily entries — conservative blocks even mild adverse hourly OBI.
pub const GBOOST_HOURLY_OBI_ADVERSE_BLOCK: Decimal = dec!(-0.25);
/// OBI momentum-exhaustion gate: block entries when |obi| exceeds threshold.
/// Conservative: 0.70 — tighter than balanced; blocks ≥70% depth imbalance.
pub const GBOOST_OBI_EXHAUSTION_BLOCK: Decimal = dec!(0.70);
/// Minimum historical volatility regime required for a GBoost entry.
/// Conservative: 0.005 — stricter than default; requires more oracle movement before allowing
/// entries.  Blocks entries during low-vol, low-confidence oracle environments.
pub const GBOOST_MIN_HIST_VOL: f64 = 0.0015; // Recalibrated from 0.005 (2026-07-10): conservative — strictest floor, still below normal BTC 60m realized-vol (~0.0025-0.0035) so GBoost can trade; blocks frozen oracle (~0.0)
pub const GBOOST_SIGNAL_EXIT_THRESHOLD: Decimal = dec!(0.55);
pub const GBOOST_MAX_EXPOSURE_USDC: Decimal = dec!(4.0);
pub const GBOOST_MIN_MARKET_AGE_SECS: i64 = 300;
pub const GBOOST_TARGET_PROFIT_PERCENT: Decimal = dec!(0.12);
pub const GBOOST_STOP_LOSS_PERCENT: Decimal = dec!(0.070); // conservative: 7.0% — raised from 0.055; tighter than balanced
