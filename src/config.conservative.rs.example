pub const GBOOST_MODEL_PATH : &str = "logs/gboost_model_v30g_o180.json";
/// Max fraction of identical labels before skipping a retrain cycle (avoids degenerate storms).
/// Conservative: same threshold — label imbalance is a data quality issue, not a risk preference.
pub const GBOOST_LOOKAHEAD_LABEL_BALANCE_MAX: f64 = 0.80;
/// 60m oracle drift block as fraction of oracle price.
/// 0.0015 = 0.15% of price. Conservative: at BTC=$100k → $150 — tighter than balanced.
pub const GBOOST_TREND_DRIFT_BLOCK_PCT: Decimal = dec!(0.0015);
