// ============================================================================
// FAIRVALUE STRATEGY PARAMETERS (2026-08-05)
// ============================================================================
// Analytic binary pricing: fair P(up) = Φ( ln(S/K) / (σ·√T) ). See config.rs.

pub const ENABLE_FAIRVALUE_TRADING: bool = true;
pub const FAIRVALUE_TRADE_SIZE_USDC: Decimal = dec!(4);
pub const FAIRVALUE_MAX_EXPOSURE_USDC: Decimal = dec!(8);
/// Aggressive: matches config.rs defaults.
pub const FAIRVALUE_BASE_EDGE: Decimal = dec!(0.08);
pub const FAIRVALUE_MIN_EDGE: Decimal = dec!(0.02);
pub const FAIRVALUE_EDGE_TAPER_SECS: i64 = 1800;
// Horizon-scaled edge: beyond the taper, req edge grows as sqrt(T/taper), capped.
pub const FAIRVALUE_EDGE_HORIZON_CAP: Decimal = dec!(0.25);
// Floor on sigma per sqrt-second — a quiet sampling hour must not collapse the model.
pub const FAIRVALUE_MIN_SIGMA_PER_SQRT_SEC: f64 = 4.2e-5;
/// Horizon at or below which the sigma floor does not bind (ramps to full at 2x).
/// Defaults to the vol window: trust the measurement as far out as we measured.
pub const FAIRVALUE_SIGMA_FLOOR_HORIZON_SECS: i64 = 0;
/// Absolute sigma backstop against degenerate input (frozen oracle / zero variance).
pub const FAIRVALUE_ABSOLUTE_MIN_SIGMA_PER_SQRT_SEC: f64 = 1.0e-5;
// Circuit breaker: stop entering a market after this many stop-loss exits on it.
pub const FAIRVALUE_MAX_STOP_LOSSES_PER_MARKET: u32 = 1;
/// Rolling window over which the model's own fair-value noise is measured.
pub const FAIRVALUE_EDGE_NOISE_WINDOW_SECS: u64 = 900;
/// Reference horizon the per-sample fair-value noise is rescaled to by √t,
/// chosen to match the observed median hold (~2 minutes).
pub const FAIRVALUE_EDGE_NOISE_HORIZON_SECS: u64 = 120;
/// Samples required before the noise gate can bind. Below this the gate blocks
/// rather than waves through — a freshly rotated market is when the model is
/// least stable, so an unmeasured edge there is the one least worth taking.
pub const FAIRVALUE_EDGE_NOISE_MIN_SAMPLES: usize = 20;
/// Multiple of that noise the edge must clear before an entry is allowed.
///
/// Prod telemetry (2026-08-13/14, 48 hourly evaluations): |Δfair| over a ~2min
/// tick had p75 = 0.078 and p90 = 0.179 against a base edge of 0.08 — 24% of
/// ticks moved further than the entire edge being claimed. An edge smaller than
/// the model's own noise is not a measurement. 0 disables the gate.
pub const FAIRVALUE_EDGE_NOISE_MULTIPLE: Decimal = dec!(1.0);

/// Multiple of the *entry* edge requirement the model must still show, at the
/// live ask, before a losing FairValue position vetoes its own non-catastrophic
/// stop loss. Higher => stricter => the stop fires more readily. 0 disables the
/// veto entirely and restores the old price-only stop.
///
/// The veto is bounded on both sides and cannot strand a position: the
/// catastrophic branch (2x the stop) is never vetoed, and the model-reversal
/// exit, the endgame bail, and settlement all remain in force. It can therefore
/// only extend a hold across the band between one and two stop widths.
///
/// Sized from production on 2026-08-15: a NO entered at $0.50 (edge +0.178 vs
/// req 0.145) stopped out at $0.44 after 206s -- six cents, 1.4x the model's own
/// 120s noise, with 3,800s still to run. The model read edge +0.145 vs req 0.140
/// at that instant and the contract settled at $1.00: -$0.48 realised against
/// +$2.46 available.
pub const FAIRVALUE_STOP_MODEL_CONFIRM_FRAC: Decimal = dec!(1.0);

// Throttle for the entry-signal info log.
pub const FAIRVALUE_ENTRY_LOG_THROTTLE_SECS: u64 = 30;
pub const FAIRVALUE_PIN_GUARD_SECS: i64 = 600;
/// Aggressive: standard pin-risk guard.
pub const FAIRVALUE_PIN_MIN_SIGMA: f64 = 1.5;
/// Time-independent coin-flip floor: refuse entries whose |d| is below this at
/// ANY time to expiry, not just inside the pin-guard window above.
///
/// Both catastrophic stop-outs on 2026-08-10 were near-strike entries with 26+
/// minutes left (d=+0.20sigma T=1578s, d=+0.07sigma T=2477s), each round-tripped
/// to a -22% loss inside two minutes. The endgame pin guard could not see them.
/// Calibrated on n=2; revisit once ~20 more round trips have accumulated.
pub const FAIRVALUE_MIN_ABS_SIGMA: f64 = 0.35;
pub const FAIRVALUE_MIN_ENTRY_PRICE: Decimal = dec!(0.25);
pub const FAIRVALUE_MAX_ENTRY_PRICE: Decimal = dec!(0.985);
pub const FAIRVALUE_MIN_SECS_TO_EXPIRY: i64 = 90;

/// Prefer the HOURLY market over the Window/Daily maker venue for entries.
/// The required edge scales with horizon and is capped at
/// FAIRVALUE_EDGE_HORIZON_CAP, so on the daily venue the requirement pins at the
/// cap (0.25) — a mispricing that does not occur on a liquid book. The hourly
/// taper lands where real edges live. False restores daily-first ordering.
pub const FAIRVALUE_PREFER_HOURLY: bool = true;
pub const FAIRVALUE_VOL_SAMPLE_SECS: u64 = 15;
pub const FAIRVALUE_VOL_WINDOW_SECS: u64 = 3600;
pub const FAIRVALUE_MIN_VOL_SAMPLES: usize = 40;
/// Aggressive: standard debounce.
pub const FAIRVALUE_ENTRY_PERSISTENCE_SECS: u64 = 45;
pub const FAIRVALUE_SIGNAL_CONTINUITY_GAP_SECS: u64 = 20;
pub const FAIRVALUE_TARGET_PROFIT_PERCENT: Decimal = dec!(0.20);
pub const FAIRVALUE_STOP_LOSS_PERCENT: Decimal = dec!(0.12);

/// FairValue entry veto on order-book imbalance for the side being bought.
/// OBI = (bid_depth − ask_depth) / total_depth on that token: −1.0 is an
/// all-offer book with no bid support.
///
/// FairValue's thesis is that the model prices a token better than the market,
/// which says nothing about whether the position can be EXITED. Buying a side
/// with no bids means crossing a wide spread in and having nothing to hit on the
/// way out, so a stop realises far more than its nominal width.
///
/// 2026-08-16 1PM BTC market: entered YES at $0.50 with YES OBI = −0.999, and
/// the catastrophic stop filled at −30% against a nominal 12% stop. Adverse-book
/// entries carried −3.04 of FairValue's −5.71 cumulative P&L over 25 trades.
/// −0.60 matches MOMENTUM_OBI_ADVERSE_BLOCK and the documented OBI circuit
/// breaker.
pub const FAIRVALUE_OBI_ADVERSE_BLOCK: Decimal = dec!(-0.60);
pub const FAIRVALUE_MIN_HOLD_SECS_BEFORE_STOP_LOSS: i64 = 120;
/// Fraction of the ENTRY fair value the model may lose before the reversal exit
/// fires (0.35 = entry fair 0.30 exits below 0.195). Entry-relative, not an
/// absolute floor — see src/config.rs for why.
pub const FAIRVALUE_MODEL_REVERSAL_DECAY_PCT: Decimal = dec!(0.35);
pub const FAIRVALUE_SETTLE_HOLD_SECS: i64 = 600;
pub const FAIRVALUE_SETTLE_HOLD_MIN_PROB: f64 = 0.90;
pub const FAIRVALUE_BAIL_SECS: i64 = 120;
pub const FAIRVALUE_BAIL_PROB: f64 = 0.75;
pub const FAIRVALUE_MIN_EXIT_BID: Decimal = dec!(0.05);
pub const FAIRVALUE_MAX_SNAPSHOT_AGE_SECS: i64 = 900; // daily book is quiet; FAK orders can't fill vs phantom quotes
pub const FAIRVALUE_POST_EXIT_COOLDOWN_SECS: i64 = 900;

