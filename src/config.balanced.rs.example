pub const TRADE_COOLDOWN_SECS: i64 = 60;
pub const PARTIAL_FILL_COOLDOWN_SECS: i64 = 30;
pub const STOP_LOSS_COOLDOWN_SECS: u64 = 180;
/// Cooldown period (in seconds) before retrying a failed exit order.
/// This prevents log floods and API hammering when FAK exits fail due to thin books.
pub const EXIT_RETRY_COOLDOWN_SECS: u64 = 5;

/// Kalshi categories that back DRADIS's `politics` market class.
///
/// Kalshi splits what DRADIS calls politics across two of its own categories,
/// and the larger one is "Elections" — omitting it hides roughly 4,000 open
/// markets. Verified against the live API 2026-08-22: Elections 3,982 open
/// markets, Politics 644, Sports 815.
pub const KALSHI_POLITICS_CATEGORIES: &str = "Elections,Politics";

/// Kalshi categories that back DRADIS's `sports` market class.
pub const KALSHI_SPORTS_CATEGORIES: &str = "Sports";

/// Keep a politics squadron running without waiting to be asked.
///
/// Kalshi previously auto-started only its crypto rotation loop, while
/// Polymarket US started all three of its wings at boot. The same customer saw
/// three squadrons on one venue and one on the other, with nothing on screen to
/// explain the difference. DRADIS now seeds a politics squadron on both.
///
/// The seeded squadron is an ordinary deployment: it appears in the Control
/// Tower deployment list, obeys the same one-per-class rule as an operator
/// deploy, and is replaced with a fresh market when its own market closes. Turn
/// this off to stop DRADIS committing capital to the class on its own.
pub const AUTO_DEPLOY_POLITICS: bool = true;

/// Keep a sports squadron running without waiting to be asked.
/// See [`AUTO_DEPLOY_POLITICS`] — same mechanism, same reasoning.
///
/// This does not depend on an Odds API key. The class trades Arbitrage and
/// Maker, which read the venue's own book; the Sports Raptor is an additive
/// signal, and without a key it idles and publishes a neutral snapshot.
pub const AUTO_DEPLOY_SPORTS: bool = true;

/// Grace period, in seconds, between an event market's close and the squadron
/// on it standing itself down.
///
/// Only event-market squadrons retire this way — the ones auto-deployed or
/// hand-deployed onto a single politics or sports market. A crypto squadron is
/// rotated onto its next market by the venue's own loop and never reaches this
/// path.
///
/// Retirement is what makes auto-deploy's documented promise true: the seeder
/// skips a class while a squadron for it is live, so a squadron that never
/// stands down holds the class slot forever. On the v1.0.4 Marketplace AMI a
/// sports squadron sat on a resolved market for hours, arbitrage and maker both
/// gated out, while live markets went unclaimed.
///
/// The grace exists because "closed" is the venue's word against our clock, and
/// because a position can still be exiting. A squadron still holding a position
/// waits regardless of this value: it keeps patrolling so its exits evaluate,
/// and retires once flat.
pub const EVENT_MARKET_RETIRE_GRACE_SECS: i64 = 300;

/// How far the exit price implied by collateral movement may sit from the bid
/// observed at exit, before the reconciliation is distrusted.
///
/// When the exchange rejects a sell with "position already gone", the P&L is
/// taken from the collateral delta across the round trip and the exit price is
/// derived from it. Two things can make that number wrong: another position
/// moving collateral in between, or a baseline captured on the wrong side of the
/// entry. Both throw the derived price away from the bid, so this band catches
/// them and the trade is booked as `ExitUnreconciled` with pnl = 0 instead.
///
/// Measured against the BID, not the entry price. Measuring from entry was a
/// real bug (production trade 378, 2026-08-20): FairValue took a legitimate
/// 20.27 percent profit, which sat 0.15 from its entry and was discarded as an
/// outlier while the bid it actually traded against was 0.026 away.
///
/// Wider = more exits priced automatically, with more risk of trusting a
/// contaminated baseline. Narrower = more booked as 0 and left for manual
/// reconciliation. Estimating from the order book is not an option at any
/// setting: that path is only reached on a rejected sell, where the book is
/// evidence of nothing.
pub const EXIT_RECONCILE_MAX_DEVIATION: Decimal = dec!(0.10);

/// Balance re-check attempts when a maker quote-pull finds the resting order GONE but the
/// on-chain balance reads zero (fully-filled order + settlement lag). Balanced: 4 attempts
/// (~15s window) — covers the observed ~14s balance-endpoint lag (trade 300).
pub const SETTLEMENT_LAG_RETRY_ATTEMPTS: u32 = 4;

/// Seconds between successive balance re-checks in the quote-pull settlement-lag loop.
pub const SETTLEMENT_LAG_RETRY_DELAY_SECS: u64 = 5;

/// Exit FAK "not enough balance" rejections within this many seconds of fill confirmation
/// are always treated as settlement lag (hold + retry), never booked as est. exits.
/// Balanced: 90s — comfortably beyond observed settlement lag without stalling slots.
pub const FRESH_FILL_SETTLEMENT_GRACE_SECS: i64 = 90;

/// Cooldown after a post-only maker quote is rejected for crossing the book.
/// Prevents tick-rate re-quote hammering while the book stays crossed.
/// Balanced: moderate cooldown.
pub const MAKER_CROSSES_BOOK_COOLDOWN_SECS: u64 = 15;

/// Flash-Exit: operational constants — same across balanced/conservative profiles.
pub const FLASH_EXIT_CONFIRM_MS: u64 = 12_000;
pub const FLASH_EXIT_POLL_MS: u64 = 500;
pub const FLASH_EXIT_EXTRA_OFFSET: Decimal = dec!(0.02);

pub const MIN_SECONDS_TO_EXPIRY_FOR_ENTRY: i64 = 300;
pub const MAX_SECONDS_TO_EXPIRY_FOR_ENTRY: i64 = 14400;
pub const FINAL_EXPIRY_WINDOW_SECS: i64 = 600;
pub const MARKET_EXPIRY_SAFETY_BUFFER_SECS: i64 = 180;


