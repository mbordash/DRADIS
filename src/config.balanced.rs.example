// ============================================================================
// LLM ADVISOR SETTINGS
// ============================================================================

/// Enable the LLM Advisor background task.
/// Balanced: enabled by default — provides regular optimization guidance.
/// Set OLLAMA_URL / OLLAMA_MODEL env vars to point at your Ollama instance.
pub const ENABLE_LLM_ADVISOR: bool = true;

pub const LLM_INFERENCE_TIMEOUT_SECS: u64 = 480;

/// How often (seconds) the advisor wakes up to analyze trades and send recommendations.
/// Balanced: every 30 minutes — once per typical hourly market cycle.
pub const LLM_ADVISOR_INTERVAL_SECS: u64 = 3600;

/// Maximum tokens the LLM Advisor may spend on one reply.
///
/// Covers the whole response: the prose analysis AND the structured proposal
/// block the policy engine parses. The block comes last, so a cap that is too
/// low does not truncate the recommendations — it removes them entirely, and
/// the advisor reports "no proposal block in response" while looking otherwise
/// healthy. Measured 2026-08-24 at 900 tokens: three consecutive Kalshi cycles
/// produced readable analysis and not one actionable change.
///
/// Purely operational, so it is the same across profiles: an aggressive
/// operator does not want a differently-sized reply, they want the same reply
/// acted on differently.
pub const LLM_MAX_OUTPUT_TOKENS: u32 = 2500;

/// Number of most-recent completed trades to include in each LLM analysis.
pub const LLM_ADVISOR_TRADES_LOOKBACK: i64 = 20;
/// How many consecutive unchanged cycles the LLM Advisor may skip before it
/// calls the provider anyway. Market conditions can move underneath an idle
/// engine, which is what the original always-call behavior protected, so the skip
/// is a rate limit rather than a mute. At the default interval this forces a
/// fresh look every few hours even when nothing has traded.
pub const LLM_ADVISOR_MAX_SKIPPED_CYCLES: u32 = 6;
/// How many cycles to stand down after a DURABLE provider failure: billing,
/// quota or authentication. Those do not recover by being retried, so retrying
/// only burns provider spend and fills the log. Expires on its own so fixing the
/// credentials needs no restart.
pub const LLM_ADVISOR_HARD_FAIL_BACKOFF_CYCLES: u32 = 12;

/// Default Ollama base URL.  Override with `OLLAMA_URL` env var.
pub const LLM_OLLAMA_URL: &str = "http://localhost:11434";

/// Default Ollama model.  Override with `OLLAMA_MODEL` env var.
pub const LLM_OLLAMA_MODEL: &str = "llama3.2";

/// Default LLM provider for the advisor. Override with the `LLM_PROVIDER` env var.
///   "ollama"    — local/remote Ollama (default; no API key)
///   "openai"    — any OpenAI-compatible endpoint; needs LLM_API_KEY + LLM_MODEL
///   "anthropic" — Anthropic API; needs LLM_API_KEY + LLM_MODEL
pub const LLM_PROVIDER: &str = "ollama";


