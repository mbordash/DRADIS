pub const ENABLE_GBOOST_TRADING: bool = true;

pub const GBOOST_MIN_ENTRY_PRICE: Decimal = dec!(0.40); // Raised from 0.35 — prevents sub-3-tick SL knockouts
pub const GBOOST_MAX_YES_ENTRY_PRICE: Decimal = dec!(0.55);
pub const GBOOST_MAX_NO_ENTRY_PRICE: Decimal = dec!(0.45);
pub const GBOOST_HISTORY_BUFFER_SIZE: usize = 2200;
pub const GBOOST_HISTORY_MIN_SPACING_MS: i64 = 500; // time-decimated snapshot buffer
pub const GBOOST_LABEL_HORIZON_SECS: i64 = 180; // oracle-based label: BTC higher after 180s
pub const GBOOST_LABEL_MIN_ORACLE_MOVE_FRAC: f64 = 0.0002; // skip flat samples (<2bp move)
pub const GBOOST_MIN_TRAINING_SAMPLES: usize = 600;
/// FIFO cap on the process-global lookahead label pool — labels accumulate across
/// retrain cycles and market rotations so flat regimes can still bootstrap the model.
pub const GBOOST_LABEL_POOL_CAP: usize = 6000;
pub const GBOOST_RETRAIN_EVERY_N: usize = 600;
/// Hard minimum wall-clock interval (seconds) between successful GBoost retrains.
/// Prevents a fast tick rate from storming booster.fit() and starving the runtime.
pub const GBOOST_MIN_RETRAIN_INTERVAL_SECS: u64 = 300;
pub const GBOOST_BUDGET: Decimal = dec!(0.80); // raised from 0.65 — gives perpetual room to grow past 1 tree
// Decimal rather than f32 so it matches every other fractional tunable, is
// readable by tools/generate-profiles.py, and round-trips through DynamicConfig
// without a float artifact. Converted to f32 at the booster call site.
pub const GBOOST_NUM_THREADS: usize = 2;

/// Hard ceiling on boosting iterations for one GBoost retrain.
///
/// `perpetual` grows trees until its budget is spent or this limit is hit,
/// whichever comes first, so this is the wall-clock guard: training runs inside
/// `spawn_blocking`, and an unbounded fit on a large label pool would hold a
/// blocking thread long enough to matter. Reaching it is not an error, it means
/// the budget had more to spend than the limit allowed.
///
/// Raise it together with the budget, or the extra budget simply cannot be used.
pub const GBOOST_ITERATION_LIMIT: u32 = 1000;
pub const GBOOST_ENTRY_THRESHOLD: Decimal = dec!(0.72); // 2026-06-30: lowered (0.88 startup default produced zero trades in 13d)
pub const GBOOST_PRED_LOG_INTERVAL_SECS: u64 = 120; // periodic P(UP) conviction diagnostic

/// Max `gboost_vetoes` rows labeled with their settled outcome per cleanup sweep.
///
/// The veto shadow-log records every entry-eligible signal a gate rejected; the
/// cleanup task attaches each one's real market resolution so the gate stack can
/// be scored on outcomes instead of on the model's own probability. Bounded per
/// sweep because each distinct market costs one Gamma request and the whole
/// cleanup pass runs under a 45s timeout — a large backlog drains over several
/// sweeps rather than starving orphan reconciliation, the safety-critical work
/// in that task.
pub const GBOOST_VETO_SCORING_BATCH: i64 = 200;
pub const GBOOST_POST_EXIT_COOLDOWN_SECS: i64 = 600;
/// Balanced: matches config.rs (2026-08-05: -0.25 vetoed 19/38 eligible signals; persistence debounce added).
pub const GBOOST_OBI_ADVERSE_BLOCK: Decimal = dec!(-0.60);
/// Entry-signal persistence debounce (2026-08-05): same side must stay eligible this long.
pub const GBOOST_ENTRY_PERSISTENCE_SECS: u64 = 120;
pub const GBOOST_SIGNAL_CONTINUITY_GAP_SECS: u64 = 30;
/// OBI EMA smoothing (2026-07-14): gates consume time-based EMA of OBI, not raw ticks.
pub const GBOOST_OBI_EMA_TAU_SECS: f64 = 60.0;
pub const GBOOST_OBI_EMA_STALE_SECS: f64 = 30.0;
/// Minimum fraction of price distance from 0.50 required for a GBoost entry.
/// Balanced: same as default — blocks coin-flip entries at 50/50.
pub const GBOOST_MIN_EDGE_FROM_FAIR: Decimal = dec!(0.04);
/// Minimum net gain fraction required before a signal-reversal exit is allowed.
/// Balanced: same as default — 4% nominal gain covers round-trip spread cost.
pub const GBOOST_SIGNAL_REV_MIN_PROFIT: f64 = 0.04;
/// Maximum combined ask sum on the TARGET (daily/window) market at entry.
/// Balanced: 1.04 = up to 4-cent spread on the daily book; blocks degenerate books.
pub const GBOOST_MAX_TARGET_ASK_SUM: Decimal = dec!(1.04);
/// Hourly OBI adverse block for daily entries — blocks contra-trend entries.
pub const GBOOST_HOURLY_OBI_ADVERSE_BLOCK: Decimal = dec!(-0.40);
/// OBI momentum-exhaustion gate: block entries when |obi| exceeds threshold.
/// Balanced: 0.80 — blocks ≥80% depth imbalance; confirmed 2026-05-08.
pub const GBOOST_OBI_EXHAUSTION_BLOCK: Decimal = dec!(0.80);
/// Minimum historical volatility regime required for a GBoost entry.
/// Balanced: 0.002 — default value; blocks entries when the oracle is completely flat.
pub const GBOOST_MIN_HIST_VOL: f64 = 0.0010; // Recalibrated from 0.020 (2026-07-10): normal BTC 60m realized-vol is ~0.0025-0.0035; old floor blocked ALL entries. Blocks frozen oracle (~0.0), admits live BTC.
pub const GBOOST_SIGNAL_EXIT_THRESHOLD: Decimal = dec!(0.50);
pub const GBOOST_MAX_EXPOSURE_USDC: Decimal = dec!(4.0);
pub const GBOOST_MIN_MARKET_AGE_SECS: i64 = 300;
pub const GBOOST_TARGET_PROFIT_PERCENT: Decimal = dec!(0.12);
pub const GBOOST_STOP_LOSS_PERCENT: Decimal = dec!(0.075); // balanced: 7.5% — raised from 0.055; model still bootstrapping
pub const GBOOST_MIN_HOLD_SECS: i64 = 300;
pub const GBOOST_SL_MIN_HOLD_SECS: i64 = 45;
pub const GBOOST_MIN_USABLE_TREES: usize = 20;
pub const GBOOST_MODEL_FILENAME: &str = "gboost_model_v30g_o180.json";
pub const GBOOST_MODEL_PATH : &str = "logs/gboost_model_v30g_o180.json";
/// Max fraction of identical labels before skipping a retrain cycle (avoids degenerate storms).
pub const GBOOST_LOOKAHEAD_LABEL_BALANCE_MAX: f64 = 0.80;
/// 60m oracle drift threshold (USD) for the trend-alignment entry gate.
/// 60m drift block as fraction of oracle price.
/// 0.002 = 0.20% of price. Balanced: at BTC=$100k → $200.
pub const GBOOST_TREND_DRIFT_BLOCK_PCT: Decimal = dec!(0.002);
pub const GBOOST_MAX_HOURLY_ASK_SUM: Decimal = dec!(1.20);
pub const GBOOST_MIN_HOURLY_BID_SUM: Decimal = dec!(0.70);
pub const GBOOST_MIN_SECS_TO_EXPIRY: i64 = 900;
pub const GBOOST_MAX_SNAPSHOT_AGE_SECS: i64 = 10;

/// Minimum hourly YES bid / maximum hourly YES ask allowed at GBoost entry.
/// Guards against entering a daily position when the hourly market is near-resolved.
pub const GBOOST_MIN_HOURLY_YES_BID: Decimal = dec!(0.25);
pub const GBOOST_MAX_HOURLY_YES_ASK: Decimal = dec!(0.95);

/// When trading the DAILY market, block DAILY NO entries if hourly YES bid > threshold
/// (strong hourly uptrend → daily NO falls) and block DAILY YES entries if hourly YES
/// ask < (1 − threshold) (strong hourly downtrend → daily YES falls).
/// 0.65 = balanced: allows entries when hourly is 35–65%, blocks when strongly trending.
/// Evidence: 2026-06-17 T1 hourly YES was 0.69 when GBoost entered DAILY NO → −$0.49 loss.
pub const GBOOST_HOURLY_STRONG_TREND_BLOCK: Decimal = dec!(0.65);

/// Seconds BTC spot must stay below (daily_strike − BASIS_BTC_ORACLE_STRIKE_BUFFER)
/// before GBoost YES entries are suppressed. 3600s = 60 min sustained below-strike.
pub const GBOOST_BELOW_STRIKE_SUPPRESS_SECS: i64 = 3600;

// ── GBoost dynamic position sizing ───────────────────────────────────────────

/// Balanced: same as config.rs default floor.
pub const GBOOST_MIN_EXPOSURE_USDC: Decimal = dec!(1.5);

/// Balanced: standard vol threshold.
pub const GBOOST_HIGH_VOL_REGIME_THRESHOLD: f64 = 0.65;

/// Balanced: 50% size reduction in elevated vol.
pub const GBOOST_HIGH_VOL_SIZE_SCALE: f64 = 0.50;

/// Balanced: 15-minute SL cooldown — longer than aggressive, shorter than conservative.
pub const GBOOST_SL_POST_EXIT_COOLDOWN_SECS: i64 = 1200;

/// Minimum expected net profit (USDC) after round-trip fees required to place a GBoost entry.
/// Balanced: $0.15 — standard threshold; filters marginal minimum-size signals near fee break-even.
pub const GBOOST_MIN_NET_PROFIT_USDC: Decimal = dec!(0.15);

/// Market-level entry hold lock (seconds) before GBoost may flip direction on a market.
/// Balanced: 180s — two retrain windows; absorbs first post-entry signal oscillation.
pub const GBOOST_MIN_HOLDING_LOCK_SECS: i64 = 180;

/// When the live data distribution deviates
/// significantly from the training distribution (as measured by perpetual's leaf-node
/// chi-squared statistic), GBoost entries are suppressed until the next retrain.
/// Balanced: 22.0 — recalibrated from live sessions (2026-06-17): normal BTC
/// intraday volatility scores 15–21; only genuine regime collapse (book
/// near-resolution, liquidity withdrawal) scores 22+. The old 5.0 textbook-chi2
/// value suppressed GBoost on ordinary vol for entire sessions.
/// NOTE: this scale is only valid with GBOOST_DRIFT_WINDOW = 400.
pub const GBOOST_CONCEPT_DRIFT_THRESHOLD: Decimal = dec!(22.0);

/// Number of recent history snapshots used for the post-retrain drift check.
/// 400 ticks (~3-4 min at the 500ms decimated cadence) — the drift-score scale
/// the thresholds above are calibrated against; do not shrink independently.
pub const GBOOST_DRIFT_WINDOW: usize = 400;

/// Number of consecutive retrains above GBOOST_CONCEPT_DRIFT_THRESHOLD required
/// before GBoost entries are suppressed.  A single retrain below the threshold
/// resets the counter and clears suppression.
/// Balanced: 3 — requires three consecutive drift triggers, avoiding false positives
/// from short-lived intra-session variance.
pub const GBOOST_DRIFT_CONSECUTIVE_REQUIRED: usize = 3;

/// Number of consecutive BELOW-threshold retrains to clear drift suppression.
/// Balanced: 2 — two consecutive below-threshold retrains (~60s) confirm the
/// regime has restabilised; longer waits kept GBoost suppressed after transients.
pub const GBOOST_DRIFT_STABLE_CLEAR_REQUIRED: usize = 2;

