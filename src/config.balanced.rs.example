pub const CLOB_API_BASE: &str = "https://clob.polymarket.com";


// ============================================================================
// MARKET FILTERING CRITERIA
// ============================================================================

pub const GAMMA_API_MARKET_SCAN_PAGES: usize = 30;

pub fn is_bad_market(name: &str) -> bool {
    let n = name.to_lowercase();
    n.contains("presidential") || n.contains("nomination") || n.contains("election") ||
        n.contains("democratic") || n.contains("republican") ||
        n.contains("masters") || n.contains("tournament") || n.contains("spieth") || n.contains("jordan") ||
        n.contains("5-minute") || n.contains("5 minute") || n.contains("5m")
}

pub fn is_long_term_2026(name: &str) -> bool {
    let n = name.to_lowercase();
    n.contains("2026") && (n.contains("win the") || n.contains("finals") || n.contains("cup") || n.contains("stanley"))
}

pub fn is_range_market(name: &str) -> bool {
    let n = name.to_lowercase();
    (n.contains("between") && n.contains("and $")) ||
    (n.contains("price of") && n.contains("between")) ||
    (n.contains("will") && (n.contains("above $") || n.contains("below $")) && !n.contains("up or down"))
}

pub fn is_hourly_crypto_market(name: &str) -> bool {
    let n = name.to_lowercase();
    is_crypto_market(&n) && (
        n.contains("up or down") ||
            n.contains("hour") ||
            n.contains("et") ||
            n.contains("pm et") ||
            n.contains("am et")
    )
}

pub fn is_high_priority_text(s: &str) -> bool {
    let n = s.to_lowercase();
    n.contains("up or down") ||
        n.contains("5 minutes") ||
        n.contains("5m") ||
        n.contains("updown") ||
        n.contains("next 5") ||
        n.contains("next hour")
}

pub fn is_crypto_market(name: &str) -> bool {
    let n = name.to_lowercase();
    n.contains("btc") || n.contains("bitcoin") ||
        n.contains("eth") || n.contains("ethereum") ||
        n.contains("sol") || n.contains("solana")
}

pub fn is_ultra_short_window_market(name: &str) -> bool {
    let n = name.to_lowercase();
    if n.contains("15 minutes") || n.contains("15 minute") { return true; }
    if let Some(window_mins) = parse_window_duration_minutes(name) { return window_mins <= 30; }
    false
}

pub fn parse_window_duration_minutes(name: &str) -> Option<u32> {
    let n = name.to_lowercase();
    if !n.contains(" et") { return None; }
    let et_pos = n.find(" et")?;
    let segment = &n[..et_pos];
    let dash_pos = segment.rfind('-')?;
    let end_part = segment[dash_pos + 1..].trim();
    let start_part = {
        let before_dash = &segment[..dash_pos];
        let space_pos = before_dash.rfind(' ').unwrap_or(0);
        before_dash[space_pos..].trim()
    };
    fn parse_minutes(s: &str) -> Option<u32> {
        let s = s.trim();
        let is_pm = s.ends_with("pm");
        let is_am = s.ends_with("am");
        if !is_pm && !is_am { return None; }
        let time_part = &s[..s.len() - 2];
        let colon = time_part.find(':')?;
        let h: u32 = time_part[..colon].parse().ok()?;
        let m: u32 = time_part[colon + 1..].parse().ok()?;
        let mut total = h * 60 + m;
        if is_pm && h != 12 { total += 720; }
        if is_am && h == 12 { total = m; }
        Some(total)
    }
    let start_mins = parse_minutes(start_part)?;
    let end_mins = parse_minutes(end_part)?;
    let duration = if end_mins >= start_mins { end_mins - start_mins } else { end_mins + 1440 - start_mins };
    Some(duration)
}

pub fn is_window_market(name: &str) -> bool {
    if let Some(mins) = parse_window_duration_minutes(name) { mins > 30 } else { false }
}

pub fn is_daily_market(name: &str) -> bool {
    let n = name.to_lowercase();
    n.contains("up or down") && n.contains(" on ") && !n.contains(" et")
}

pub fn retry_sleep_duration() -> StdDuration { StdDuration::from_secs(5) }
pub fn startup_delay() -> StdDuration { StdDuration::from_secs(10) }
pub fn connector_init_delay() -> StdDuration { StdDuration::from_secs(10) }
pub fn order_execution_delay() -> StdDuration { StdDuration::from_millis(400) }
// ============================================================================
// CONVERGENCE STRATEGY PARAMETERS
// ============================================================================
//
// The Convergence Viper is a directional, macro-conviction strategy. Unlike the
// price-driven Vipers (Momentum = 5s velocity, TrendCapture = 10–60m drift), it
// enters ONLY when the institutional + derivatives stack agrees on a direction:
//   • Tide Raptor institutional_pulse beyond threshold AND high coherence, plus
//   • Derivatives Raptor CVD confirming the same side, and OI not unwinding.
// BTC-only (institutional_pulse is BTC-only) and naturally US-market-hours-only
// (pulse is zero outside the cash session). Ships LIVE but with a tiny fixed size.

/// Enable/disable the Convergence (macro-conviction) Viper.
///
/// ⚠️  This is the compile-time startup DEFAULT — NOT a permanent setting.
/// The Control Tower UI (PATCH /api/config {"enable_convergence": false}) can
/// flip it at runtime; changes hot-load and persist to SQLite.
pub const ENABLE_CONVERGENCE_TRADING: bool = true;

/// Fixed entry size (USDC) per Convergence position — deliberately tiny while the
/// strategy proves itself live. Not Kelly-scaled (unlike Momentum/TrendCapture).
pub const CONVERGENCE_POSITION_SIZE_USDC: Decimal = dec!(5.0);

/// Hard cap on total Convergence capital at risk across all open positions.
pub const CONVERGENCE_MAX_EXPOSURE_USDC: Decimal = dec!(20.0);

/// Minimum |institutional_pulse| (z-score) required to consider a directional entry.
pub const CONVERGENCE_PULSE_THRESHOLD: Decimal = dec!(1.0);

/// Minimum Tide coherence (0..1) — the three ETFs must agree before we act.
pub const CONVERGENCE_COHERENCE_MIN: Decimal = dec!(0.6);

/// Distance from the neutral CVD ratio of 1.0 the perp taker flow must clear to
/// CONFIRM the trade direction (bull needs cvd ≥ 1+margin, bear ≤ 1−margin).
pub const CONVERGENCE_CVD_CONFIRM_MARGIN: Decimal = dec!(0.10);

/// Open-interest delta floor: positioning must not be unwinding (de-leveraging /
/// squeeze) for a conviction entry. 0.0 = require OI flat-or-building.
pub const CONVERGENCE_OI_MIN_BUILD: Decimal = dec!(0.0);

/// Highest token ask the strategy will pay to enter (no edge buying near $1).
pub const CONVERGENCE_MAX_ENTRY_PRICE: Decimal = dec!(0.65);

/// Lowest token ask considered tradable (avoid lottery-ticket tails).
pub const CONVERGENCE_MIN_ENTRY_PRICE: Decimal = dec!(0.35);

/// Max per-token bid-ask spread (fraction of ask). A hollow bid guarantees an
/// instant stop-out, so skip when the spread is wider than this.
pub const CONVERGENCE_MAX_TOKEN_SPREAD_PCT: Decimal = dec!(0.04);

pub const CONVERGENCE_EXHAUSTION_DRIFT_60M_PCT: Decimal = dec!(0.0015);

/// Drift-coherence deadband, as a fraction of oracle price (2026-08-11).
///
/// Gates the 10m-vs-60m drift AGREEMENT check: a drift leg whose magnitude is
/// below this counts as neutral (no opinion) rather than as a direction, so the
/// coherence test only fires on two genuinely opposed moves.
///
/// 0.0005 = 0.05% of price (~$32 at BTC $64k) — a third of the exhaustion
/// ceiling, so it clears oracle noise without swallowing real short-term moves.
/// Calibrated against the 2026-08-11 pair: the winner (id 344) ran drift_10m
/// −30.4 / drift_60m −16.4 (same sign, coherent → passes regardless of the
/// deadband), while the −13.6% loser (id 347) ran drift_10m +78.3 against
/// drift_60m −361.8 — both legs clear $32, so the opposition is unambiguous.
pub const CONVERGENCE_DRIFT_COHERENCE_DEADBAND_PCT: Decimal = dec!(0.0005);

/// Velocity-opposition deadband, as a fraction of oracle price (2026-08-11).
///
/// Blocks entry when the 5s oracle velocity is actively running AGAINST the
/// intended side by more than this. Deliberately a deadband and not a
/// "velocity must confirm" rule: `velocity` is 0 whenever the price feed is
/// flat or history is short, and the 2026-08-11 winner (id 344) entered at
/// velocity exactly 0.00 — requiring positive confirmation would have blocked
/// it. Only ACTIVE opposition should veto.
///
/// 0.00004 = 0.004% of price (~$2.55 at BTC $64k, i.e. $2.55 per 5s window).
/// The loser (id 347) bought YES at velocity −4.01 — price falling while the
/// strategy paid up for the bullish side — which clears this with margin.
pub const CONVERGENCE_VELOCITY_OPPOSITION_PCT: Decimal = dec!(0.00004);
pub const CONVERGENCE_SKIP_BAND_LOW: Decimal = dec!(0.45);
pub const CONVERGENCE_SKIP_BAND_HIGH: Decimal = dec!(0.55);
pub const CONVERGENCE_OBI_ADVERSE_BLOCK: Decimal = dec!(0.50); // 2026-06-30: block entry into adverse order-book imbalance

/// Entry-relative take-profit and stop-loss.
pub const CONVERGENCE_TARGET_PROFIT_PERCENT: Decimal = dec!(0.08); // 2026-07-10: 0.15 never hit (decay-exit first); 8% (~+5.7% net) stops fee-eroded 5% scalps. LIVE knob overrides in prod.
pub const CONVERGENCE_STOP_LOSS_PERCENT: Decimal = dec!(0.10);

/// Catastrophic stop applied BEFORE fill-confirmation (negative = loss fraction).
pub const CONVERGENCE_CATASTROPHIC_SL_PCT: Decimal = dec!(-0.15); // 2026-07-10: tightened from -0.20 — caps the fast-whipsaw tail (9 trades -16 to -24%) ~6-8pts.

/// Catastrophic backstop = this multiple of the live stop-loss, clamped to
/// CONVERGENCE_CATASTROPHIC_SL_PCT. Scales the hard floor with a tight stop.
pub const CONVERGENCE_CATASTROPHIC_SL_MULT: Decimal = dec!(1.5); // 2026-07-10: 2.0 -> 1.5 tightens catastrophic across the live-stop range (-15% at a 10% stop).

/// After a catastrophic stop, block BOTH legs of that market for this long.
pub const CONVERGENCE_CATASTROPHIC_COOLDOWN_SECS: u64 = 900;  // legacy — superseded by CONVERGENCE_STOP_MARKET_COOLDOWN_SECS

/// Market-wide cooldown (both legs) after ANY stop exit — regular SL or catastrophic.
/// A stop-out means the market hour is chopping against the macro signal — stand down.
pub const CONVERGENCE_STOP_MARKET_COOLDOWN_SECS: u64 = 1800;

/// Entry-signal persistence debounce: the full signal stack must hold continuously
/// this many seconds before entry (filters transient mid-vol-burst pulses).
pub const CONVERGENCE_ENTRY_PERSISTENCE_SECS: u64 = 60;

/// Max gap (seconds) between signal sightings before the persistence clock resets.
pub const CONVERGENCE_SIGNAL_CONTINUITY_GAP_SECS: u64 = 30;

/// Per-token cooldown after any exit before re-entry is allowed (seconds).
pub const CONVERGENCE_POST_EXIT_COOLDOWN_SECS: u64 = 300;

/// Minimum hold (seconds) before a normal stop-loss or reversal exit may fire.
pub const CONVERGENCE_MIN_HOLD_SECS: i64 = 60;

/// After emitting an Exit, suppress further exit signals for this many seconds
/// (prevents FAK-miss re-fire storms while patrol executes).
pub const CONVERGENCE_EXIT_SIGNAL_COOLDOWN_SECS: u64 = 20;

/// Minimum market maturation (seconds) before Convergence will open in a market.
pub const CONVERGENCE_MARKET_WARMUP_SECS: i64 = 60;
