/// Scale a percentage-based threshold to an absolute dollar amount using the
/// current oracle price.  Replaces the old per-asset dollar constants.
#[inline]
pub fn oracle_threshold(pct: Decimal, oracle_price: Decimal) -> Decimal {
    pct * oracle_price
}

pub const ENABLE_MOMENTUM_TRADING: bool = true;

pub const MOMENTUM_KELLY_MAX_MULTIPLIER: Decimal = dec!(3.0);
pub const MOMENTUM_MIN_TRADE_SIZE_USDC: Decimal = dec!(5.0);
pub const MOMENTUM_MAX_TRADE_SIZE_USDC: Decimal = dec!(25.0);

pub const MOMENTUM_CONFIRMATION_TICKS: u32 = 3;

pub const MOMENTUM_TARGET_PROFIT_PERCENT: Decimal = dec!(0.10);
pub const MOMENTUM_STOP_LOSS_PERCENT: Decimal = dec!(0.11);
pub const MOMENTUM_REVERSAL_RATIO: Decimal = dec!(0.75);
pub const MOMENTUM_MIN_HOLD_SECS_BEFORE_REVERSAL: i64 = 45;
pub const MOMENTUM_FILL_CONFIRM_MIN_HOLD_SECS: i64 = 30;
pub const MOMENTUM_MIN_HOLD_BEFORE_SL_SECS: i64 = 120;
pub const LATE_MARKET_SIZE_THRESHOLD_SECS: i64 = 1800;
pub const MOMENTUM_EXPIRY_EXIT_SECS: i64 = 900;
pub const MOMENTUM_EXPIRY_MIN_PROFIT_TO_HOLD: Decimal = dec!(0.02);
pub const MOMENTUM_TAKE_PROFIT_CEILING: Decimal = dec!(0.90);

/// Multiple of the round-trip taker fee that the Momentum take-profit target must
/// clear. Venue fees are entry-price dependent — on Polymarket intl the round trip
/// costs 2 x rate x (1 - entry) of notional, so a $0.20 entry burns 11.2% while a
/// $0.80 entry burns only 2.8%. A flat percentage target is therefore below break-even
/// across part of the permitted entry range (at TP=10% every entry under $0.286 is a
/// guaranteed net loss). The effective target is raised to this multiple of the
/// computed fee whenever the configured target would not clear it.
/// Balanced: 1.35 — take-profit must beat fees by 35%.
pub const MOMENTUM_TP_FEE_MARGIN_MULT: Decimal = dec!(1.35);

/// Strike buffer as fraction of oracle price.
/// 0.0005 = 0.05% of price. Balanced: at BTC=$100k → $50.
pub const STRIKE_BUFFER_PCT: Decimal = dec!(0.0001);

pub const MAX_MOMENTUM_ENTRY_PRICE: Decimal = dec!(0.60);
pub const MAX_MOMENTUM_CROSSING_ENTRY_PRICE: Decimal = dec!(0.62);
pub const MOMENTUM_MIN_ENTRY_PRICE: Decimal = dec!(0.20); // Balanced: 18-82% probability range
pub const MOMENTUM_CATASTROPHIC_SL_PCT: Decimal = dec!(0.17); // Balanced: 1.5x the 11% stop-loss — a true last-resort floor

pub const MOMENTUM_WINDOW_SECS: u64 = 5;
pub const MOMENTUM_SHORT_WINDOW_SECS: u64 = 1;
pub const DRIFT_60M_MIN_WINDOW_SECS: u64 = 600;
pub const MOMENTUM_SHORT_WINDOW_FRACTION: Decimal = dec!(0.65);
pub const MOMENTUM_ACCELERATION_BYPASS_MULTIPLIER: Decimal = dec!(2.5);
pub const MOMENTUM_DECAY_EXIT_FRACTION: Decimal = dec!(0.20);

/// Velocity threshold as fraction of oracle price/5s.
/// 0.001 = 0.10% of price. Balanced: at BTC=$100k → $100/5s.
pub const MOMENTUM_THRESHOLD_PCT: Decimal = dec!(0.001);

/// Legacy alias kept for LLM advisor prompt references.
pub const BTC_MOMENTUM_THRESHOLD: Decimal = dec!(100.0);

/// Window market consensus filter — moderate directional veto.
pub const MOMENTUM_WINDOW_BEARISH_BLOCK: Decimal = dec!(0.30);
pub const MOMENTUM_WINDOW_BULLISH_BLOCK: Decimal = dec!(0.70);

/// OBI adverse veto: skip entries when the book is moderately stacked against the trade.
pub const MOMENTUM_OBI_ADVERSE_BLOCK: Decimal = dec!(-0.30);

/// OBI exhaustion veto: block entries when the bid side dominates entirely (all buyers, no sellers).
/// Balanced: 0.70 — tightened to avoid buying exhausted rallies.
pub const MOMENTUM_OBI_EXHAUSTION_BLOCK: Decimal = dec!(0.70);

/// Deepest drawdown at which the in-position OBI-exhaustion exit may still fire.
/// Past this the position is already wrecked and the (catastrophic) stop-loss owns it,
/// so the early-reversal exit stands down. Balanced: -0.16 ≈ 1.5x the 11% stop-loss.
pub const MOMENTUM_OBI_EXHAUST_MAX_ADVERSE_PCT: Decimal = dec!(-0.16);

/// Minimum seconds a Momentum position must be held before the in-position
/// OBI-exhaustion exit may fire. Without this the exit triggers on the first tick
/// after fill confirmation, when the position is underwater by the bid/ask spread
/// alone (2026-08-19 10:55 ET: entered $0.43, exited $0.40 five seconds later on a
/// -6.97% "loss" that was pure spread; the token went on to $0.95).
/// Mirrors MOMENTUM_MIN_HOLD_SECS_BEFORE_REVERSAL — OBI exhaustion is a reversal signal.
pub const MOMENTUM_OBI_EXHAUST_MIN_HOLD_SECS: i64 = 45;

/// How long the book must read exhausted, continuously, before the OBI exit fires.
/// Single-sample OBI on the hourly book is noise: the 2026-08-19 10:00-11:15 ET
/// heartbeats swing +0.95 -> -0.80 -> +0.93 -> -0.93 minute to minute, crossing the
/// 0.70 threshold constantly. Expressed in seconds rather than ticks deliberately —
/// the patrol loop runs at 75ms, so any tick count small enough to look reasonable
/// (3, 5, 10) is a quarter-second and filters nothing. Any non-exhausted reading
/// resets the clock. Balanced: 12s.
pub const MOMENTUM_OBI_EXHAUST_PERSIST_SECS: i64 = 12;

/// Maximum OBI swing allowed at Momentum entry.
/// Balanced: 0.80 — standard protection against book-sweep entries.
pub const MOMENTUM_OBI_SWING_BLOCK: Decimal = dec!(0.80);

/// 10-minute oracle drift alignment gate — blocks momentum entries that contradict the
/// medium-term BTC trend (dead-cat bounce / relief-rally filter).
/// Balanced: 2× threshold (-50/+50) — standard protection.
/// Set to dec!(-9999) / dec!(9999) to disable.
/// 10m drift block as fraction of oracle price.
/// 0.0005 = 0.05% of price. Balanced: at BTC=$100k → $50.
/// Set to dec!(9999) to disable.
pub const MOMENTUM_DRIFT_10M_BLOCK_PCT: Decimal = dec!(0.00075);

/// Maximum combined ask sum (YES_ask + NO_ask) allowed for a Momentum entry.
/// Balanced: 3-cent combined spread cap — allows some widening but blocks clearly broken books.
pub const MOMENTUM_MAX_ENTRY_ASK_SUM: Decimal = dec!(1.025);

/// Maximum age (seconds) of the live orderbook snapshot at Momentum entry.
/// Stale snapshots silently retain last-known OBI/depth values — unreliable veto data.
pub const MOMENTUM_MAX_SNAPSHOT_AGE_SECS: i64 = 15;


// ============================================================================
// MAKER (PASSIVE LIMIT ORDER) STRATEGY PARAMETERS
// ============================================================================

pub const ENABLE_MAKER_TRADING: bool = true;

pub const MAKER_VELOCITY_BIAS_THRESHOLD: Decimal = dec!(25.0);
/// Oracle-drift quote pull: cancel unfilled resting quote on adverse oracle move.
/// The oracle leads OBI by minutes — pulls stale quotes before informed takers arrive.
pub const MAKER_ORACLE_DRIFT_PULL_FRAC: Decimal = dec!(0.0003); // 08-04: tightened from 0.0005 — prod fills won the cancel race at 5 bps (4/4 on 08-04).
/// Oracle-drift ToxicFill exit: bail out of a FILLED position when the oracle has
/// moved this far against it since the quote was placed. The oracle leads OBI by
/// minutes, so waiting for OBI to confirm is how a filled position bleeds — on
/// 2026-08-27 one went 13.51% adverse over 363s before OBI breached. Looser than
/// the pull threshold above on purpose: cancelling an unfilled quote is free,
/// while exiting a position pays the spread to realize a loss. Set 0 to disable.
pub const MAKER_ORACLE_DRIFT_EXIT_FRAC: Decimal = dec!(0.0015);
/// Gate-dwell: gates must pass continuously this long before quoting.
/// Blocks quoting into gate flicker during directional moves (instant-fill toxicity).
pub const MAKER_GATE_DWELL_SECS: i64 = 15;

// ── Horizon Raptor maker gate (2026-07-21, observe-first) ───────────────────
/// Master switch: false = observe-only (log "would veto", never suppress).
/// Balanced: enforced — prod observe period (2026-07-21→31) showed vetoes
/// correlate with maker adverse-selection losses and spare the winners.
pub const MAKER_HORIZON_GATE_ENFORCE: bool = true;
/// Suppress BOTH maker sides when UVXY 5s velocity exceeds this ($/5s).
pub const MAKER_HORIZON_VIX_VEL_MAX: Decimal = dec!(0.10);
/// Suppress the adverse maker side when |tradfi_velocity| exceeds this ($/5s).
pub const MAKER_HORIZON_TRADFI_VETO: Decimal = dec!(0.15);
/// Directional TradFi vetoes require at least this QQQ-vs-BTC macro coherence.
pub const MAKER_HORIZON_COHERENCE_MIN: Decimal = dec!(0.5);
pub const MAKER_BID_BUFFER: Decimal = dec!(0.025);
pub const MAKER_MIN_SPREAD: Decimal = dec!(0.04);
pub const MAKER_BID_IMPROVEMENT: Decimal = dec!(-0.01);
pub const MAKER_BID_IMPROVEMENT_RATIO: Decimal = dec!(0.00);
pub const MAKER_MIN_BID_IMPROVEMENT: Decimal = dec!(-0.02);
pub const MAKER_MAX_BID_IMPROVEMENT: Decimal = dec!(0.00);
pub const MAKER_CROSS_BUFFER: Decimal = dec!(0.02);

/// Anchor maker bids to the BEST BID rather than only to the ask.
///
/// The quote is priced `ask - maker_bid_buffer`, which is correct on a tight
/// book: ask 0.52 / bid 0.50 quotes 0.50, right at the bid. On a WIDE book it
/// posts a bid most of the way across the spread. Observed on Kalshi
/// 2026-08-27: YES bid 0.35 / ask 0.53, the maker quoted 0.51 — sixteen cents
/// above the best bid — and the position marked to the bid instantly, tripping
/// the catastrophic stop at -31.37%. The book never moved; the whole loss was
/// the entry price.
///
/// `maker_min_spread` cannot catch this: it rejects books that are too TIGHT,
/// so the wider the spread the more eagerly the maker crosses it. The
/// `maker_cross_buffer` clamp only stops the quote nearing the ask; nothing
/// anchored it to the bid.
///
/// With this true (the default) the quote is additionally capped at
/// `best_bid + one tick` — the maker improves the bid rather than crossing to
/// the ask, which is what a maker is for. Set false to restore the ask-anchored
/// behaviour.
pub const MAKER_IMPROVE_BID_ONLY: bool = true;
pub const CROSSES_BOOK_COOLDOWN_SECS: i64 = 30;
/// Balanced: 5s pause lets the WS snapshot refresh without stalling entries long.
pub const CROSSES_BOOK_RETRY_PAUSE_SECS: u64 = 5;

pub const MAKER_MIN_SECS_TO_EXPIRY: i64 = 1800;
/// Standard 1-day horizon for maker venue discovery.
pub const MAKER_MAX_SECS_TO_EXPIRY: i64 = 86400;

pub const MAKER_MAX_ENTRY_PRICE: Decimal = dec!(0.48);
pub const MAKER_MAX_COMPLEMENTARY_PRICE: Decimal = dec!(0.65);
pub const MAKER_MIN_ENTRY_PRICE: Decimal = dec!(0.10);

pub const MAKER_TARGET_PROFIT_PERCENT: Decimal = dec!(0.07);
pub const MAKER_STOP_LOSS_PERCENT: Decimal = dec!(0.15);
pub const MAKER_LATE_MARKET_STOP_TIGHTEN_SECS: i64 = 2700;
pub const MAKER_LATE_MARKET_STOP_LOSS_PERCENT: Decimal = dec!(0.08);
pub const MAKER_MIN_HOLD_SECS_BEFORE_STOP: i64 = 300;
pub const MIN_HOLD_SECS_BEFORE_STOP_LOSS: i64 = MAKER_MIN_HOLD_SECS_BEFORE_STOP;
/// Catastrophic floor at (live SL × mult), ungated by min-hold (2026-07-14).
pub const MAKER_CATASTROPHIC_SL_MULT: Decimal = dec!(1.5);
pub const MAKER_STOP_LOSS_COOLDOWN_SECS: i64 = 600;
pub const MAKER_MAX_COMBINED_BID: Decimal = dec!(0.85);
pub const MAKER_MAX_BOOK_IMBALANCE_RATIO: Decimal = dec!(3.0);

/// Taker-flow / bid-depth drain gate.
/// Balanced: suppress entry when 40%+ of bid depth drains in 1.5s;
/// exit on a moderately adverse book turn (OBI < -0.50).
pub const MAKER_TAKER_FLOW_WINDOW_MS: u64 = 2500;
/// Minimum elapsed ms between depth snapshots before the drain check runs.
/// Prevents price-level rotation (normal tick moves) from false-triggering suppression.
pub const MAKER_TAKER_FLOW_MIN_ELAPSED_MS: u64 = 500;
pub const MAKER_TAKER_FLOW_DRAIN_THRESHOLD: Decimal = dec!(0.75);
pub const MAKER_TOXIC_FLOW_EXIT_OBI: Decimal = dec!(-0.50);
/// After a ToxicFill exit, block re-entry on that same token for this long.
/// Prevents the maker from immediately re-quoting into a collapsing book and
/// getting picked off again (the "double knife-catch" adverse-selection loss).
/// Balanced: 3-minute re-entry lockout.
pub const MAKER_TOXIC_REENTRY_COOLDOWN_SECS: i64 = 180;

// ── Operator-deployed squadron horizon (2026-08-23) ─────────────────────────
//
// Longest time-to-resolution a Quick deploy will auto-select, in days.
//
// Market DISCOVERY deliberately looks much further out — Kalshi structures
// politics and sports as multi-year futures, and a browse list that hides them
// shows an empty category. Auto-SELECTION is a different question: the vipers
// available to those classes are Arbitrage and Maker, and neither works on a
// multi-year horizon. Arbitrage locks collateral until resolution, so a two-year
// market ties up the whole book for a few percent; Maker rests quotes expecting
// fills and reversion on a session scale. A market resolving in 2028 is a
// perfectly good market and a bad thing to point these strategies at.
//
// Raising this widens what Quick deploy may choose; it does not change what the
// browse list shows, so an operator can always deploy a longer-dated market
// deliberately by picking it by hand.
pub const DEPLOY_MAX_DAYS_TO_CLOSE: u32 = 90;

// ── Order-book imbalance source (2026-08-23) ────────────────────────────────
//
// Whether the OBI entry gates read whole-book depth instead of the touch.
//
// The touch is the size resting at the best price only. On a thin book that is
// one or two contracts, so a ratio built from it swings wildly on trades that
// move nothing. Measured over 1,720 leg-samples on Kalshi, the two disagreed in
// SIGN 41% of the time, and 188 of 247 crypto entry vetoes fired on a touch the
// rest of the book contradicted — the extreme case reading +0.97 at the touch
// against -0.01 across a book holding 683,574 vs 702,306 contracts.
//
// Defaults to false — the touch — because that measurement is from Kalshi and
// the gate is venue-neutral. Switching cut simulated crypto vetoes by 57%, which
// is a large loosening of a risk control to apply to a venue on the strength of
// another venue's book structure. Turn it on per squadron, compare, then decide.
//
// Deliberately does NOT affect the GBoost feature vector: that model is trained
// on touch-derived features, and changing their meaning underneath it at runtime
// would leave it predicting from a distribution it never saw.
pub const OBI_USE_WHOLE_BOOK: bool = false;

// ── ToxicFill confirmation gates ────────────────────────────────────────────
// Applied ONLY to a confirmed fill; an unfilled resting quote is still pulled
// instantly. Without them the exit fires on the OBI dip caused by our own quote
// being lifted, paying the spread to realize a loss price has not inflicted.

/// Minimum seconds held before ToxicFill may fire.
/// Balanced: 30s — covers the window dominated by our own vanished quote.
pub const MAKER_TOXIC_MIN_HOLD_SECS: i64 = 30;

/// Bid must be at least this fraction below avg entry for ToxicFill to fire.
/// Balanced: 2% ≈ 1 tick at a $0.40 entry — the smallest non-flicker move.
pub const MAKER_TOXIC_MIN_ADVERSE_PCT: Decimal = dec!(0.02);

/// Consecutive OBI breaches required before ToxicFill fires.
/// Balanced: 3 ticks — sub-second confirmation at the 50ms patrol tick.
pub const MAKER_TOXIC_OBI_CONFIRM_TICKS: u32 = 3;

// ── Resting maker exit ──────────────────────────────────────────────────────
// Post a post-only GTC ASK against a filled position so it exits by being
// lifted (spread capture) rather than crossing back to the bid. FAK-at-bid
// still handles stops, ToxicFill and the near-expiry flatten.

/// Master switch for the resting-ask maker exit.
pub const MAKER_RESTING_EXIT_ENABLED: bool = true;

/// Price floor for the resting ask, as a fraction over avg entry.
/// Balanced: 4% — clears round-trip costs with room, below the bid-based TP.
pub const MAKER_RESTING_EXIT_MIN_EDGE_PCT: Decimal = dec!(0.04);

/// Ticks to undercut the best ask by when posting the resting exit.
/// Balanced: 1 — one tick buys a materially higher fill probability.
pub const MAKER_RESTING_EXIT_ASK_IMPROVEMENT_TICKS: i64 = 1;

/// Minimum price change before an existing resting ask is repriced.
/// Balanced: 2¢ — keeps queue priority through ordinary book flicker.
pub const MAKER_RESTING_EXIT_REPRICE_THRESHOLD: Decimal = dec!(0.02);

/// Slow trend threshold as fraction of oracle price.
/// 0.003 = 0.30% of price. Balanced: at BTC=$100k → $300.
pub const MAKER_SLOW_TREND_THRESHOLD_PCT: Decimal = dec!(0.003);
pub const MAKER_INVENTORY_SKEW_MAX: Decimal = dec!(0.03);

pub const MAKER_MIN_MARKET_AGE_SECS: i64 = 300;
/// Ceiling on the maturation wait, expressed as a fraction of the market's own
/// lifetime. The absolute `MAKER_MIN_MARKET_AGE_SECS` wait is right for a daily
/// market and nonsense for a 15-minute one: a 600s wait against a 13-minute
/// Kalshi market left a two-minute quoting window once the 60s RTB cutoff took
/// its share, so the Maker viper effectively never quoted there.
///
/// The effective wait is `min(MAKER_MIN_MARKET_AGE_SECS, fraction x market_life)`,
/// where market_life is measured as observed age + seconds to close. At 0.25 a
/// daily market still serves the full absolute wait, while a 13-minute market
/// matures in ~195s and keeps most of its life tradeable.
pub const MAKER_MATURATION_MAX_FRACTION: Decimal = dec!(0.25);
/// Throttle interval (secs) for MakerStrategy gate-rejection diagnostics — a gate
/// reason is logged when it changes or after this interval, without per-tick spam.
pub const MAKER_GATE_LOG_INTERVAL_SECS: u64 = 30;

/// Re-log interval for a TimeDecay gate rejection whose reason has NOT changed.
/// A change of reason always logs immediately; this only paces the repeat.
///
/// 300s (vs the maker's 30s) because TimeDecay evaluates a much slower condition:
/// its theta window is minutes wide and its blocking gate can legitimately hold
/// for a whole market. Gives a recoverable on-disk history of which gate blocks
/// it, which the in-memory viper_status registry alone cannot provide.
pub const TIME_DECAY_GATE_LOG_INTERVAL_SECS: u64 = 300;
/// How long to quiet REPEATS of the re-entry suppression notice in
/// `orchestrator::executor`. The guard fires every tick while an exit is in
/// flight, which produced 380 WARN lines in 40 minutes on 2026-08-27. A change
/// in which legs are blocked still reports immediately; only unchanged repeats
/// are held back. Log verbosity, not trading behavior — same treatment as
/// TIME_DECAY_GATE_LOG_INTERVAL_SECS above.
pub const REENTRY_SUPPRESS_LOG_INTERVAL_SECS: u64 = 300;
pub const MOMENTUM_MIN_MARKET_AGE_SECS: i64 = 300;
/// Must be strictly > MOMENTUM_EXPIRY_EXIT_SECS (900s); 300s breathing room.
pub const MOMENTUM_MIN_SECS_TO_EXPIRY_FOR_ENTRY: i64 = 1200;

/// Minimum seconds since market switch before MomentumStrategy is allowed to enter.
/// Balanced: 60s — standard warmup for orderbook depth to stabilise.
/// Root cause fix for 2026-05-27 20:11 loss (−$0.73): entry fired 6s after switch.
pub const MOMENTUM_MARKET_WARMUP_SECS: i64 = 90;


