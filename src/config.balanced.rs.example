// ============================================================================
// BALANCED CONFIG EXAMPLE
// ============================================================================
//
// A middle-ground between capital preservation and opportunity capture.
// All five strategies are enabled with moderate position sizes and filters.
// A good starting point for users with some Polymarket experience.
//
// Good for: wallets of $100–$300, stable market conditions.
//
// To use: copy this file to src/config.rs, then `cargo build --release`.
// ============================================================================

use rust_decimal::Decimal;
use rust_decimal_macros::dec;
use std::time::Duration as StdDuration;

// ============================================================================
// NOTIFICATION SETTINGS
// ============================================================================

pub const ENABLE_TELEGRAM: bool = false;
pub const ENABLE_X: bool = false;


// ============================================================================
// ARBITRAGE STRATEGY PARAMETERS
// ============================================================================

pub const GHOST_MODE: bool = false;

/// Should a BRAND-NEW install start in simulation?
///
/// Distinct from `GHOST_MODE`, and the distinction matters. `GHOST_MODE` is a
/// build-level switch compiled into the binary; setting it true would put a
/// running deployment into permanent simulation regardless of what its operator
/// chose. This one seeds only the DEFAULT of the runtime `ghost_mode` knob, so
/// it applies exactly once — to an install with no persisted config yet — and an
/// existing deployment keeps whatever is in its database.
///
/// True because the alternative is a customer's first experience of the product
/// being an unexpected real trade: the profile baked into the Marketplace AMI
/// enables five strategies, so saving credentials and restarting is enough to
/// start placing live orders. They can turn it off from the Control Tower the
/// moment they mean to.
pub const GHOST_MODE_DEFAULT: bool = true;
pub const ENABLE_ARBITRAGE_TRADING: bool = true;

/// Min net profit after fees to trigger arbitrage.
/// Adjusted from 0.03 to 0.04 to be more conservative.
pub const ARBITRAGE_PROFIT_THRESHOLD: Decimal = dec!(0.015);
pub const ARBITRAGE_MAX_TAKER_FEE_BPS: u32 = 1500; // Updated from 200

/// Quote-persistence debounce: profitable bid_sum must hold continuously this many
/// seconds before the arb enters (filters phantom arbs during fast BTC moves).
pub const ARB_QUOTE_PERSISTENCE_SECS: u64 = 3;

/// Maximum allowable gap between our safe bid and the current ask on each arb leg.
/// Adjusted from 0.05 to 0.03 to be more strict about liquidity.
pub const ARBITRAGE_MAX_FILL_GAP: Decimal = dec!(0.05);

/// Maximum price allowed for either arb leg (YES bid OR NO bid).
/// Balanced: 0.60 — requires both legs in the genuine-uncertainty band [0.40, 0.60].
/// Root cause of the 2026-05-19 "10 YES / 40 NO" imbalance (YES=72¢, NO=27¢).
pub const ARBITRAGE_MAX_LEG_PRICE: Decimal = dec!(0.60);
/// Increased from 0.02 to 0.03 to give more buffer for FAK re-hedges.
pub const ARB_FAK_REHEDGE_BUFFER: Decimal = dec!(0.02);

/// Seconds the orphan arbiter waits, after cancelling the missing leg's GTC,
/// before re-reading its on-chain balance and committing to a repair.
///
/// Guards one specific race: the cancel may have arrived just after a taker fill
/// that was still settling on-chain, and flattening on a stale zero balance
/// would sell a leg we actually own. The grace lets Polygon settle (~2s/block)
/// so Step 3's re-read sees the truth.
///
/// It is NOT the only protection, which is why it can be short: after the
/// flatten, ARBITER_LATE_FILL_WATCH_SECS keeps watching the missing leg and
/// flattens + books it if it fills late. The downside of guessing wrong is
/// therefore bounded at two spreads, while the cost of waiting is unbounded
/// naked directional exposure -- so shorter is the safer side of this trade.
///
/// Was hardcoded at 10s. On 2026-08-15 a TimeDecay leg took 26s from entry to
/// flatten (10s fill-confirm, 5s asymmetric grace, 10s here, ~1s to trade) while
/// YES collapsed 0.56 -> 0.38; the move was over before the repair began.
pub const ARB_SETTLE_GRACE_SECS: u64 = 3;
pub const ARB_FLATTEN_MIN_BID_BUFFER: Decimal = dec!(0.02);
pub const ARB_FLATTEN_BID_HAIRCUT_PCT: Decimal = dec!(0.05);
/// Upper bound on single-leg orphan rescue cost in the arb entry gate. Balanced default.
pub const ARB_MAX_RESCUE_COST: Decimal = dec!(1.00);
pub const ARBITRAGE_MAX_OBI_ASYMMETRY: Decimal = dec!(0.60);
pub const ARBITRAGE_MAX_LEG_OBI: Decimal = dec!(0.50);
/// Min conviction: dominant leg bid must be ≥ this to enter — restricts arb to deep
/// near-settlement markets and rejects ≈0.50 coin-flips (core orphan guard). Balanced default.
pub const ARBITRAGE_MIN_LEG_CONVICTION: Decimal = dec!(0.90);

pub const MAX_SUM_PRICE_FOR_ENTRY: Decimal = dec!(0.96);
pub const MIN_ORDER_SHARES: Decimal = dec!(1.0);
pub const MIN_ORDER_USDC: Decimal = dec!(1.05);
/// Token-sovereignty dust threshold (notional USDC). A held position below this is
/// dust and won't block another viper from entering the same token. Balanced default.
pub const TOKEN_SOVEREIGNTY_DUST_NOTIONAL_USDC: Decimal = dec!(3.0);

/// Discount applied to current bid when setting avg_entry for a reconciled orphaned position.
/// Guarantees profit_margin ≈ 33% on first tick → immediate TakeProfit exit at current market price.
/// All profiles use the same value — reconciled positions should always exit promptly regardless of style.
pub const RECONCILE_ADOPTED_ENTRY_DISCOUNT: Decimal = dec!(0.25);
pub const MIN_LIQUIDITY_FILL_RATIO: Decimal = dec!(0.80);
pub const BUY_PRICE_OFFSET: Decimal = dec!(0.01);

// ── Fleet-wide risk controls (2026-06-29) ────────────────────────────────────
/// Balanced: flat sizing — cap losses on violent high-strength setups.
pub const ENABLE_KELLY_SIZING: bool = false;
/// Block entries within this many seconds of resolution (gap-through risk).
pub const ENTRY_MIN_SECS_TO_RESOLUTION: i64 = 900;
/// Require exit-side bid depth ≥ position × this ratio (else stop gaps through).
pub const ENTRY_MIN_EXIT_BID_DEPTH_RATIO: Decimal = dec!(1.0);
pub const MOMENTUM_BUY_PRICE_OFFSET: Decimal = dec!(0.03);
pub const MOMENTUM_ENTRY_FAK_RETRIES: u32 = 2;
pub const MAX_BUY_LIMIT_PRICE: Decimal = dec!(0.99);
pub const SELL_PRICE_OFFSET: Decimal = dec!(0.01);
pub const MIN_SELL_LIMIT_PRICE: Decimal = dec!(0.01);

/// Polymarket taker fee rate: `fee = rate * p * (1 - p) * shares`, charged on
/// both legs of a round trip. Makers pay nothing. Venue fact, identical across
/// profiles — see src/config.rs for why it is 7% and not the advertised 1000 bps.
pub const INTL_TAKER_FEE_RATE: Decimal = dec!(0.07);
pub const EARLY_EXIT_COMBINED_BID_THRESHOLD: Decimal = dec!(0.995);


// ============================================================================
// MOMENTUM & ORACLE SETTINGS (Predictive Arbitrage)
