# Private internal design doc (do not publish)
docs/VENUE_ABSTRACTION.md
docs/us_retail_api.md
tools/cleanup-phantom-single-leg-settlements.sh
tools/dedupe-duplicate-settlements.sh
/ROADMAP.md

# Private keys
*.pem
data/
# Per-instance data directories created by start-local.sh when several venues
# run from one checkout. Each holds a secrets.env with real credentials — the
# same reason data/ is ignored, and the pattern that must match it.
data-*/

# Sonar study artifacts (tools/sonar_backtest.py) — bulky API caches, not source
tools/.sonar_cache/
tools/__pycache__/

# MCP integration (integrations/mcp) — installed locally by the operator
integrations/mcp/node_modules/
integrations/mcp/package-lock.json
tools/sonar_addresses.json
tools/sonar_backtest.py
tools/check-config-drift.sh
tools/check-profile-ladder.py
