# ============================================================================
# DRADIS Environment Configuration
# Copy this file to .env and fill in your own values.
#
# DRADIS builds as ONE venue at a time. Fill in only the section for the
# venue you are building:
#
#   • International CLOB  (default build)            → SECTION 1 + SECTION 4
#       cargo build / cargo run
#
#   • US Retail (CFTC-regulated Polymarket US)       → SECTION 2 + SECTION 4
#       cargo run --no-default-features --features us_retail
#
#   • Kalshi (CFTC-regulated US exchange)            → SECTION 3 + SECTION 4
#       cargo run --no-default-features --features kalshi
#
# SECTION 4 (shared) applies to all builds. The settings for the venues you
# are NOT building are simply ignored — but keeping them out of your .env
# avoids confusion.
# ============================================================================


# ============================================================================
# SECTION 1 — INTERNATIONAL CLOB BUILD  (default)
# ----------------------------------------------------------------------------
# Required for the default build. IGNORED by the us_retail build.
# Authenticates with an on-chain wallet private key (EIP-712 signing).
# ============================================================================

# Your Polymarket trading account private key (REQUIRED for the default build)
# Get this from your Polymarket wallet setup.
# KEEP THIS SECRET - Never commit the actual .env file to git!
POLYMARKET_PRIVATE_KEY=your_private_key_here

# ── POLYGON RPC ENDPOINT (REQUIRED for auto-settlement) ──────────────────────────
# The auto-settlement feature requires a reliable, paid Polygon (EVM) RPC provider.
# Free public RPC endpoints (polygon-rpc.com, Ankr, PublicNode) are unreliable
# and will cause settlement failures with "API key disabled" or nonce gas errors.
#
# ⚠️  Helius is a Solana-only RPC — do NOT use it here. It will return
#     "Method not found" errors because it doesn't support Polygon/EVM methods.
#
# Recommended providers (all have free tiers, all support Polygon):
#  - Alchemy:   https://www.alchemy.com/           (recommended — easy setup)
#  - QuickNode: https://www.quicknode.com/
#  - Infura:    https://infura.io/
#
# Examples:
#   Alchemy:   POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY
#   QuickNode: POLYGON_RPC_URL=https://polygon-mainnet.quiknode.pro/YOUR_KEY/
#   Infura:    POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/YOUR_API_KEY
#
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Initial trade size in USDC for each position
# Recommended: Start with 1-5 USDC for testing
TRADE_SIZE_USDC=3

# Optional: Filter by crypto type when using multiple containers
# This is set automatically by deploy-multi.sh for each container (btc, eth, sol)
# Only set this if running a single container
# CRYPTO_FILTER=btc


# ============================================================================
# SECTION 2 — US RETAIL BUILD  (--no-default-features --features us_retail)
# ----------------------------------------------------------------------------
# Required ONLY for the CFTC-regulated Polymarket US exchange. IGNORED by the
# default (international CLOB) build.
#
# The US venue does NOT use a wallet private key. Instead, create an API key on
# the Polymarket US developer portal — it issues a Key ID and a Secret Key
# (shown only once). Every request is signed locally with Ed25519; there is no
# JWT/login step.
# ============================================================================

# Developer-portal Key ID (UUID) — sent as the X-PM-Access-Key header. (REQUIRED)
POLYMARKET_US_KEY_ID=00000000-0000-0000-0000-000000000000

# Developer-portal Secret Key — Base64 of the Ed25519 keypair, shown ONCE at
# creation. KEEP THIS SECRET; it is the full signing key. (REQUIRED)
POLYMARKET_US_SECRET_KEY=your_base64_secret_key_here

# ── Optional US tuning ───────────────────────────────────────────────────────
# Override the gateway base URL (defaults to the production endpoint below).
# POLYMARKET_US_BASE_URL=https://api.prod.polymarketexchange.com
# Contracts per arbitrage leg (default 10).
# POLYMARKET_US_TRADE_SIZE=10
# Minimum risk-free edge per YES+NO pair, in dollars (default 0.02).
# POLYMARKET_US_ARB_EDGE=0.02
# Pick one market by slug/question substring (optional).
# POLYMARKET_US_MARKET_FILTER=chiefs
# Keep the dashboard pool tidy — US data lives in logs/us-dradis.db.
# ASSETS=us


# ============================================================================
# SECTION 3 — KALSHI BUILD  (--no-default-features --features kalshi)
# ----------------------------------------------------------------------------
# Required ONLY for the Kalshi exchange (CFTC-regulated, kalshi.com). IGNORED
# by the other builds.
#
# Kalshi signs every request locally with RSA-PSS. Create an API key in your
# Kalshi account settings — it issues a Key ID (UUID) and lets you download
# the RSA private key PEM file (shown/downloadable only once).
#
# ⭐ TIP: start with the DEMO environment (paper trading, play money):
#    1. Create an account at https://demo.kalshi.co
#    2. Generate an API key in the demo account settings
#    3. Set KALSHI_DEMO=1 below — demo and production credentials are separate.
# ============================================================================

# API Key ID (UUID) from account settings. (REQUIRED)
KALSHI_API_KEY_ID=00000000-0000-0000-0000-000000000000

# Path to the downloaded RSA private key PEM file. KEEP THIS SECRET. (REQUIRED)
# Alternatively, set KALSHI_PRIVATE_KEY to the PEM contents directly.
KALSHI_PRIVATE_KEY_PATH=data/kalshi-key.pem

# Paper trading against demo.kalshi.co (1 = demo, unset/0 = production).
KALSHI_DEMO=1

# ── Optional Kalshi tuning ───────────────────────────────────────────────────
# Comma-separated crypto series to hunt (default below). 15M = 15-minute
# markets, D = hourly above/below. Also available: KXSOL15M, KXXRP15M, …
# KALSHI_SERIES=KXBTC15M,KXBTCD,KXETH15M,KXETHD
# Pick one market by ticker/title substring (optional).
# KALSHI_MARKET_FILTER=bitcoin
# Keep the dashboard pool tidy — Kalshi data lives in logs/kalshi-dradis.db.
# ASSETS=kalshi


# ============================================================================
# SECTION 4 — SHARED  (applies to ALL builds)
# ============================================================================

# Rust logging level (affects log verbosity)
# Options: trace, debug, info, warn, error
# Recommended: info or debug for monitoring
RUST_LOG=info,dradis=info

# ── Control Tower UI Auth (RECOMMENDED for production) ───────────────────────
# If set, the Control Tower dashboard requires HTTP Basic Auth.
# Leave unset for local development (no login prompt).
# CT_USERNAME=admin
# CT_PASSWORD=change-me-before-deploying

# ── API Key Auth for External Access (optional) ──────────────────────────────
# When set, the DRADIS REST API (:9000) requires X-API-Key: <value> on every
# request. The Control Tower proxy forwards this automatically — no UI changes
# needed. Leave unset for local development (open access on localhost).
# Required if you expose port 9000 externally (e.g. via Cloudflare Tunnel for
# OpenClaw or other third-party integrations).
# DRADIS_API_KEY=replace-with-a-strong-random-secret

# ── UI-Managed Secrets (Control Tower "Setup" tab) ───────────────────────────
# All credentials in this file can ALSO be entered through the Control Tower's
# Setup tab — no shell access needed. UI-entered values are persisted to
# $DRADIS_DATA_DIR/secrets.env (default ./data/secrets.env, on the mounted data
# volume in Docker) and OVERRIDE this .env on boot, since Docker injects
# --env-file values at container-create time and never re-reads them.
#
# Precedence at boot: data/secrets.env  >  .env / container env
#
# First boot with no admin password: the Setup tab shows a first-boot wizard —
# create the admin password, enter venue credentials, then Restart to apply.
# The admin password hash and session key are stored in secrets.env as
# DRADIS_ADMIN_HASH / DRADIS_SESSION_KEY (never set these by hand).
# DRADIS_DATA_DIR=./data
#
# Already gating access with CT_USERNAME/CT_PASSWORD + DRADIS_API_KEY? Disable
# the separate Setup admin password entirely (setup routes stay behind those
# layers). Leave unset for public/AMI deployments — the wizard forces a gate.
# DRADIS_SETUP_AUTH=off

# ── Read-Only Demo Mode (optional) ───────────────────────────────────────────
# When set to true, the engine rejects EVERY mutating API request (any method
# other than GET/HEAD) with 403 — config patches, viper toggles, position exits,
# chain sync. The live raptor telemetry and all read endpoints keep streaming.
# This is the server-side half of the public demo at demo.dradis.live; pair it with
# NEXT_PUBLIC_DEMO_MODE=true in the Control Tower so the UI shows the demo banner
# and disables controls. Strongly recommended to also force GHOST_MODE on.
# DRADIS_READ_ONLY=true

# ── Optional: Telegram Notifications
# To get these:
# 1. Create a bot using @BotFather to get your token
# 2. Get your chat ID (using a bot like @userinfobot)
# 3. Set pub const ENABLE_TELEGRAM: bool = true; in src/config.rs
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Optional: Alpaca real-time IEX feed for Tide + Horizon Raptors ────────────
# Powers two raptors from a SINGLE Alpaca connection (free tier allows only one):
#
#   Tide Raptor    — BTC ETF (IBIT/FBTC/ARKB) premium vs synthetic iNAV
#   Horizon Raptor — TradFi velocity (SPY/QQQ) and VIX proxy (UVXY)
#
# Use Alpaca's FREE tier (real-time, IEX-sourced, single-venue — NOT delayed).
# Leave unset to run both raptors in observe-only mode (pills show offline).
#
# PREFERRED: set this from the Control Tower Setup view's "Raptor Signal Sources"
# panel instead of here. Keys entered there are written to data/secrets.env, which
# survives container recreation and OVERRIDES anything set in this file. These
# entries remain supported for headless/first-boot provisioning.
# ALPACA_API_KEY_ID=your_alpaca_key_id_here
# ALPACA_API_SECRET_KEY=your_alpaca_secret_key_here

# ── Optional: The Odds API key for the Sports Raptor ─────────────────────────
# Powers the venue-neutral Sports Raptor's line-movement feed — cross-book h2h
# odds it reduces to a vig-free consensus probability, line drift, and book
# dispersion. Free tier at https://the-odds-api.com (hard ~500 req/mo; the raptor
# polls every 2h ≈ 360 req/mo and logs remaining budget each poll). Leave unset to
# run the Sports Raptor idle/observe-only (neutral snapshot, "Sports Raptor" pill shows offline).
#
# PREFERRED: set this from the Control Tower Setup view's "Raptor Signal Sources"
# panel, which also offers a "Test key" button that validates the key against a
# quota-exempt endpoint (so testing never spends part of the free tier).
# ODDS_API_KEY=your_the_odds_api_key_here

# ── Optional: Live Tennis API key for the Tennis Raptor ──────────────────────
# Powers the venue-neutral Tennis Raptor's live event-state feed — one tracked
# live match reduced to sets/games/points, the serving side, and a derived
# break-point flag, with feed-staleness reporting. Free tier at
# https://livetennisapi.com (30 req/min, 100 req/day; the default 900s poll
# stays inside the day cap and the raptor logs remaining budget each poll).
# Leave unset to run the Tennis Raptor idle/observe-only (neutral snapshot,
# tennis telemetry reports offline).
# LIVETENNIS_API_KEY=your_livetennisapi_key_here

# ── Optional: LLM Advisor provider ────────────────────────────────────────────
# Default is local/remote Ollama (no key). Set LLM_PROVIDER to use a hosted API:
#   ollama    — OLLAMA_URL / OLLAMA_MODEL (defaults from config.rs)
#   openai    — any OpenAI-compatible endpoint (OpenAI, Groq, Together,
#               OpenRouter, vLLM, LM Studio…); requires LLM_API_KEY + LLM_MODEL,
#               optional LLM_API_BASE (default https://api.openai.com/v1)
#   anthropic — requires LLM_API_KEY + LLM_MODEL,
#               optional LLM_API_BASE (default https://api.anthropic.com)
# API keys live in the environment only — never persisted to DB or logged.
# LLM_PROVIDER=openai
# LLM_API_BASE=https://api.openai.com/v1
# LLM_API_KEY=your_llm_api_key_here
# LLM_MODEL=gpt-4o-mini

# ── Optional: LLM autonomy (config-patch policy engine) ───────────────────────
# Tier for LLM-proposed config changes (Setup-view control coming; env for now):
#   1 — Recommend-only: proposals queue for human approval (default)
#   2 — Limited: safe changes auto-apply (schema-clamped, ±20% delta cap,
#       no money fields, rate-limited); the rest queue for approval
#   3 — Autonomous: everything auto-applies (still schema-clamped; ghost_mode
#       flips always need a human), guarded by the P&L circuit breaker
# LLM_AUTONOMY_TIER=1
# Hard stop for all auto-applies at any tier (proposals still queue):
# LLM_AUTONOMY_KILL=1
# Tier-2 guardrails:
# LLM_MAX_PATCHES_PER_HOUR=1
# LLM_MAX_DELTA_PCT=0.20
# Circuit breaker: revert auto-applied changes + demote to tier 1 when session
# P&L draws down more than this (USDC) within the window after an apply:
# LLM_BREAKER_DRAWDOWN_USDC=25.0
# LLM_BREAKER_WINDOW_SECS=14400
# Outcome scoring: hours after an AI apply/revert at which the session-P&L
# delta is recorded as the action's outcome (feeds few-shot retraining):
# LLM_OUTCOME_HORIZON_SECS=7200
